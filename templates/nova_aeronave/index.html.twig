      'novaaeronave.save.saving': 'Saving…',
      'novaaeronave.error.generic': 'Could not save the aircraft — check your connection and try again.'
    };
    for (var k in d) { window.KATABATIC_I18N_EN[k] = d[k]; }
  })();
</script>
<script src="/assets/js/pages/nova-aeronave.js" defer></script>
{% endblock %}
