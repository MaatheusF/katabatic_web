{% extends 'app_base.html.twig' %}

{% block title %}Novo voo — Katabatic{% endblock %}
{% block meta_description %}Registrar um novo voo Katabatic, por importação de telemetria ou manualmente.{% endblock %}

{% block page_stylesheets %}
<link rel="stylesheet" href="/assets/css/pages/novo-voo.css">
{% endblock %}

{% block bar %}
<div class="bar">
  <a class="back" href="{{ path('app_portal') }}"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg><span data-i18n="rail.logbook">Logbook</span></a>
  <span class="sep">/</span>
  <h1 data-i18n="nav.newflight">Novo voo</h1>
  <div class="right">
    <div class="lang" role="group" aria-label="Idioma">
      <button type="button" data-lang="pt" aria-pressed="true">PT</button>
      <button type="button" data-lang="en" aria-pressed="false">EN</button>
    </div>
    <button class="icon-btn" id="theme" aria-label="Tema">
      <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
  </div>
</div>
{% endblock %}

{% block content %}
<div class="wrap">

  <!-- Escolha de modo -->
  <div class="modepick">
    <button class="mode on" id="mode-import" type="button">
      <div class="mode-top">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v12m0 0l-4-4m4 4l4-4M5 21h14"/></svg>
        <b>Importar telemetria</b>
        <span class="rec">Recomendado</span>
      </div>
      <p>A partir da pasta gerada pelo script de captura (samples.csv, env.csv, events.csv). A dificuldade é calculada da telemetria — nada é digitado.</p>
    </button>
    <button class="mode" id="mode-manual" type="button">
      <div class="mode-top">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
        <b>Registro manual</b>
      </div>
      <p>Sem arquivo de telemetria — para voos fora do sim ou quando a captura falhou. Entra no logbook marcado como não verificado.</p>
    </button>
  </div>

  <!-- Telemetria (modo importar) -->
  <div class="card" id="card-import">
    <div class="card-h"><span class="n">1</span><h3>Telemetria</h3><span class="note">comece por aqui — o resto se preenche sozinho</span></div>
    <div class="card-b">
      <div class="dropzone" id="dropzone" tabindex="0">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 4v11m0 0l-3.5-3.5M12 15l3.5-3.5"/><path d="M4 16v2.5A1.5 1.5 0 0 0 5.5 20h13a1.5 1.5 0 0 0 1.5-1.5V16"/></svg>
        <b>Arraste a pasta do voo aqui</b>
        <span>ou clique para selecionar · samples.csv, env.csv, events.csv, session.json</span>
      </div>
      <div id="import-result"></div>
    </div>
  </div>

  <!-- Registro manual (modo manual, escondido por padrao) -->
  <div class="card" id="card-manual" style="display:none">
    <div class="card-h"><span class="n">1</span><h3>Dados do voo</h3></div>
    <div class="card-b">
      <div class="warn-box">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 9v4m0 4h.01M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg>
        <p>Sem telemetria medida, este voo entra no logbook com a marca <b>não verificado</b> e a dificuldade abaixo é uma estimativa sua — não conta para o índice comparativo entre voos.</p>
      </div>
      <div class="grid2" style="margin-top:16px">
        <div class="field">
          <label>Duração</label>
          <input type="text" class="mono-input" placeholder="1:20">
        </div>
        <div class="field">
          <label>Condição predominante</label>
          <select>
            <option>Claro</option><option>Chuva</option><option>Neve</option><option>Nevoeiro</option><option>Turbulência</option>
          </select>
        </div>
      </div>
      <div class="field">
        <label>Ocorrência <span style="text-transform:none;letter-spacing:0">(pode marcar mais de uma)</span></label>
        <div class="chips" id="ocor-chips">
          <button class="chip on" data-ocor="Nenhuma" type="button">Nenhuma</button>
          <button class="chip" data-ocor="Pouso duro" type="button">Pouso duro</button>
          <button class="chip" data-ocor="Quique" type="button">Quique</button>
          <button class="chip" data-ocor="Overspeed" type="button">Overspeed</button>
          <button class="chip" data-ocor="Estol" type="button">Estol</button>
        </div>
      </div>
      <div class="field" style="margin-bottom:0">
        <label>Dificuldade estimada</label>
        <div class="slider-row">
          <input type="range" id="f-diff-manual" min="0" max="100" value="40">
          <b id="diff-manual-val">40</b>
        </div>
      </div>
    </div>
  </div>

  <!-- Identificação -->
  <div class="card">
    <div class="card-h"><span class="n">2</span><h3>Identificação</h3></div>
    <div class="card-b">
      <div class="grid2">
        <div class="field">
          <label>Callsign</label>
          <div class="callsign-row">
            <span class="callsign-prefix">KBT</span>
            <input type="text" class="mono-input" id="f-call" placeholder="118" maxlength="3">
          </div>
          <p class="hint" id="call-hint">Faixa numérica sugere o tipo: <b>1xx</b> carga · <b>2xx</b> pessoal · <b>4xx</b> pesquisa · <b>9xx</b> reposicionamento</p>
        </div>
        <div class="field">
          <label>Aeronave</label>
          <select id="f-aircraft">
            <option value="">Selecione…</option>
            {% for a in aircraft %}
            <option value="{{ loop.index0 }}">{{ a.reg }} · {{ a.tipo }} · {{ a.base }}</option>
            {% endfor %}
          </select>
          <div class="aircraft-pick" id="aircraft-pick" style="display:none"></div>
          <div class="warn-box" id="tail-mismatch" style="display:none;margin-top:10px"></div>
        </div>
      </div>

      <div class="field">
        <label>Tipo de operação</label>
        <div class="chips" id="tipo-chips">
          <button class="chip on" data-tipo="Carga" type="button">Carga</button>
          <button class="chip" data-tipo="Pessoal" type="button">Pessoal</button>
          <button class="chip" data-tipo="Pesquisa" type="button">Pesquisa</button>
          <button class="chip" data-tipo="Reposicionamento" type="button">Reposicionamento</button>
        </div>
      </div>

      <div class="grid2">
        <div class="field">
          <label>Data <span id="date-lock-tag" style="display:none;color:var(--ok);text-transform:none;letter-spacing:0">· detectado do arquivo</span></label>
          <div style="display:flex;gap:6px">
            <input type="date" id="f-date">
            <button class="icon-btn" id="date-unlock" type="button" title="Editar manualmente" style="display:none;flex:none">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
            </button>
          </div>
        </div>
        <div class="field">
          <label>Hora (Zulu)</label>
          <input type="time" id="f-time" class="mono-input">
        </div>
      </div>
    </div>
  </div>

  <!-- Rota -->
  <div class="card">
    <div class="card-h"><span class="n">3</span><h3>Rota</h3><span class="note">a maioria dos destinos é livre — preencha o que foi voado</span></div>
    <div class="card-b">
      <div class="grid2">
        <div class="field">
          <label>Origem (ICAO)</label>
          <input type="text" class="mono-input" id="f-orig" placeholder="PAFA" maxlength="4" style="text-transform:uppercase">
          <p class="hint" id="orig-hint"></p>
        </div>
        <div class="field">
          <label>Destino (ICAO)</label>
          <input type="text" class="mono-input" id="f-dest" placeholder="PABT" maxlength="4" style="text-transform:uppercase">
        </div>
      </div>
      <div class="field" style="margin-bottom:0">
        <label>SimBrief OFP <span style="text-transform:none;letter-spacing:0">(opcional)</span></label>
        <input type="text" class="mono-input" id="f-simbrief" placeholder="Ex.: 4471902">
      </div>
    </div>
  </div>

  <!-- Missao -->
  <div class="card">
    <div class="card-h"><span class="n">4</span><h3>Missão</h3></div>
    <div class="card-b">
      <div class="field">
        <label>Objetivo</label>
        <input type="text" id="f-obj" placeholder="Ex.: Suprimento de campo avançado, apoio a estação de pesquisa…">
      </div>
      <div class="field">
        <label>Relato do piloto <span style="text-transform:none;letter-spacing:0">(opcional agora, dá para completar depois)</span></label>
        <textarea id="f-report" rows="4" placeholder="O que o sensor não mede: por que desviou, como foi a decisão em voo…"></textarea>
        <div class="charcount" id="report-count">0 caracteres</div>
      </div>
      <div class="field" style="margin-bottom:0">
        <label>Visibilidade</label>
        <div class="chips" id="vis-chips">
          <button class="chip on" data-vis="publico" type="button">Público no site</button>
          <button class="chip" data-vis="interno" type="button">Somente interno</button>
        </div>
        <p class="hint">Voos de teste ou avaliação geralmente ficam <b>somente internos</b> — dá para tornar público depois.</p>
      </div>
    </div>
  </div>

  <p class="hint" style="text-align:center;margin-top:4px">A verificação contra o datafeed da VATSIM roda automaticamente ao publicar — não é preciso confirmar aqui.</p>

  <div class="footer-actions">
    <a class="btn btn-ghost" href="{{ path('app_portal') }}" data-i18n="common.cancel">Cancelar</a>
    <div class="right">
      <button class="btn" id="btn-draft" data-i18n="novovoo.savedraft">Salvar rascunho</button>
      <button class="btn btn-primary" id="btn-publish" disabled data-i18n="novovoo.publish">Publicar voo</button>
    </div>
  </div>

</div>
{% endblock %}

{% block page_javascripts %}
<script>
  window.KATABATIC_AIRCRAFT = {{ aircraft|json_encode|raw }};
</script>
<script src="/assets/js/pages/novo-voo.js" defer></script>
{% endblock %}
