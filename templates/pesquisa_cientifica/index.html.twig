{% extends 'app_base.html.twig' %}

{% block title %}Área científica — {{ voo.callsign }} — Katabatic{% endblock %}
{% block meta_description %}Condições meteorológicas capturadas ao vivo durante o voo de pesquisa {{ voo.callsign }}.{% endblock %}

{% block page_stylesheets %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<link rel="stylesheet" href="/assets/css/pages/pesquisa-cientifica.css">
{% endblock %}

{% block bar %}
<div class="bar">
  <a class="back" href="{{ path('app_voo') }}"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg><span data-i18n="rail.logbook">Logbook</span></a>
  <span class="sep">/</span>
  <h1 data-i18n="pesquisa.title">Área científica</h1>
  <div class="right">
    <div class="lang" role="group" aria-label="Idioma" data-i18n-attr="aria-label:a11y.language">
      <button type="button" data-lang="pt" aria-pressed="true">PT</button>
      <button type="button" data-lang="en" aria-pressed="false">EN</button>
    </div>
    <button class="icon-btn" id="theme" aria-label="Tema" data-i18n-attr="aria-label:a11y.theme">
      <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
  </div>
</div>
{% endblock %}

{% block content %}
<div class="wrap">

  {% if pesquisa is null %}
  <div class="card pc-empty">
    <div class="card-b">
      <p data-i18n="pesquisa.empty">Este voo não tem dados de pesquisa meteorológica — ou não é um voo de Pesquisa, ou a sessão ACARS não enviou nenhum heartbeat de posição durante o voo.</p>
    </div>
  </div>
  {% else %}
  {% set relatorio = pesquisa.relatorio %}
  {% set resumo = relatorio.resumoMissao %}

  {% if pesquisa.sintetico %}
  <div class="pc-sintetico" data-i18n="pesquisa.sintetico">Dados obtidos por reprocessamento — clima e imagens capturados ao vivo no momento do reprocessamento, sobre a rota e os horários reais deste voo, não o clima histórico real na hora em que ele aconteceu.</div>
  {% endif %}

  <div class="pc-mission">
    <div class="pc-mission-h">
      <h2>{{ resumo.titulo }}</h2>
      <span class="pc-badge pc-badge-{{ resumo.piorCondicao }}">{{ resumo.piorCondicao|upper }}</span>
    </div>
    <div class="pc-mission-meta">
      <span><b>{{ resumo.callsign }}</b> · {{ resumo.tipoAeronave }} · {{ resumo.aeronaveReg }}</span>
      <span>{{ resumo.rota }}</span>
      <span>{{ resumo.data }} · {{ resumo.horaInicioZ }} · {{ resumo.duracao }}</span>
    </div>
  </div>

  <div class="card pc-map-card">
    <div class="card-h">
      <h3 data-i18n="pesquisa.map.title">Mapa da missão</h3>
      <div class="pc-map-controls">
        <div class="pc-imgmode" role="group" aria-label="Modo de exibição da imagem do mapa">
          <button type="button" data-modo="captura" aria-pressed="true" data-i18n="pesquisa.map.modo.captura">Por leitura</button>
          <button type="button" data-modo="mosaico" aria-pressed="false" data-i18n="pesquisa.map.modo.mosaico">Mosaico contínuo</button>
        </div>
        <label class="pc-follow">
          <input type="checkbox" id="pc-follow-alt" checked>
          <span data-i18n="pesquisa.map.follow">Seguir altitude da aeronave</span>
        </label>
        <select id="pc-nivel" class="pc-select" disabled></select>
        <label class="pc-toggle">
          <input type="checkbox" id="pc-precip-toggle" checked>
          <span data-i18n="pesquisa.map.precip">Mapa de precipitação</span>
        </label>
        <label class="pc-toggle">
          <input type="checkbox" id="pc-vento-toggle" checked>
          <span data-i18n="pesquisa.map.wind">Vento animado</span>
        </label>
      </div>
    </div>
    <div class="card-b" style="padding:0">
      <div id="pc-map"></div>
      <div class="pc-timeline" id="pc-timeline">
        <p class="hint" id="pc-timeline-empty" data-i18n="pesquisa.timeline.empty">Nenhuma captura de mapa/vento armazenada para este voo.</p>
      </div>
    </div>
  </div>

  {% if relatorio.indicadoresTelemetria is defined and relatorio.indicadoresTelemetria is not empty %}
  <div class="card">
    <div class="card-h">
      <h3 data-i18n="pesquisa.telemetria.title">Telemetria real da aeronave</h3>
    </div>
    <div class="card-b">
      <div class="pc-indicadores">
        {% for ind in relatorio.indicadoresTelemetria %}
        <div class="pc-indicador pc-indicador-{{ ind.tag }}">
          <span class="pc-indicador-label">{{ ind.label }}</span>
          <span class="pc-indicador-valor">{{ ind.valor }}</span>
        </div>
        {% endfor %}
      </div>
      <p class="hint" data-i18n="pesquisa.telemetria.hint">Dados reais dos sensores/telemetria da aeronave (MSFS) — diferente da previsão meteorológica externa mostrada no resto da página.</p>
    </div>
  </div>
  {% endif %}

  <div class="card" id="pc-sentido-card">
    <div class="card-h">
      <h3 data-i18n="pesquisa.sentido.title">Condições sentidas ao longo da rota</h3>
    </div>
    <div class="card-b">
      <div class="pc-charts" id="pc-charts">
        <p class="hint" id="pc-charts-empty" data-i18n="pesquisa.sentido.empty">Amostras insuficientes para montar os gráficos de evolução.</p>
      </div>
      <p class="hint" data-i18n="pesquisa.sentido.hint">Vento, rajada, temperatura e precipitação da previsão meteorológica ao longo da rota, amostrados durante o voo. Os pontos de máximo/mínimo de cada gráfico também aparecem marcados no mapa da missão, acima.</p>
    </div>
  </div>

  <div class="card">
    <div class="card-h"><h3 data-i18n="pesquisa.narrativa.title">Narrativa da missão</h3></div>
    <div class="card-b pc-narrativa">
      {% for paragrafo in relatorio.narrativa %}
      <p>{{ paragrafo }}</p>
      {% endfor %}
    </div>
  </div>

  {% if relatorio.destaques is not empty %}
  <div class="card">
    <div class="card-h"><h3 data-i18n="pesquisa.destaques.title">Destaques</h3></div>
    <div class="card-b">
      <ul class="pc-destaques">
        {% for destaque in relatorio.destaques %}
        <li>{{ destaque }}</li>
        {% endfor %}
      </ul>
    </div>
  </div>
  {% endif %}

  <div class="card">
    <div class="card-h"><h3 data-i18n="pesquisa.estatisticas.title">Estatísticas</h3></div>
    <div class="card-b">
      <table class="pc-stats">
        <tbody>
          {% for linha in relatorio.estatisticas %}
          <tr><th>{{ linha.label }}</th><td>{{ linha.valor }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  {% endif %}

</div>
{% endblock %}

{% block page_javascripts %}
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/leaflet-velocity@1.9.2/dist/leaflet-velocity.min.js" defer></script>
<script>
  (function () {
    var d = {
      'pesquisa.title': 'Scientific area',
      'pesquisa.empty': "This flight has no weather research data — either it isn't a Research flight, or the ACARS session never sent a position heartbeat during the flight.",
      'pesquisa.sintetico': 'Data obtained by reprocessing — weather and imagery captured live at reprocessing time, over this flight’s real route and timestamps, not the actual historical weather when it happened.',
      'pesquisa.map.title': 'Mission map',
      'pesquisa.map.modo.captura': 'Per reading',
      'pesquisa.map.modo.mosaico': 'Continuous mosaic',
      'pesquisa.map.follow': 'Follow aircraft altitude',
      'pesquisa.map.precip': 'Precipitation map',
      'pesquisa.map.wind': 'Animated wind',
      'pesquisa.timeline.empty': 'No map/wind captures stored for this flight.',
      'pesquisa.narrativa.title': 'Mission narrative',
      'pesquisa.destaques.title': 'Highlights',
      'pesquisa.estatisticas.title': 'Statistics',
      'pesquisa.telemetria.title': 'Real aircraft telemetry',
      'pesquisa.telemetria.hint': 'Real data from the aircraft\'s own sensors/telemetry (MSFS) — different from the external weather forecast shown in the rest of the page.',
      'pesquisa.sentido.title': 'Conditions felt along the route',
      'pesquisa.sentido.hint': 'Wind, gust, temperature and precipitation from the weather forecast along the route, sampled during the flight. Each chart\'s max/min points are also marked on the mission map above.',
      'pesquisa.sentido.empty': 'Not enough samples to build the evolution charts.'
    };
    for (var k in d) { window.KATABATIC_I18N_EN[k] = d[k]; }
  })();
  window.KATABATIC_PESQUISA = {{ pesquisa|json_encode|raw }};
  window.KATABATIC_TRACK = {{ track|json_encode|raw }};
  window.KATABATIC_CARTO_API_KEY = {{ cartoApiKey|json_encode|raw }};
  window.KATABATIC_VOO_STARTED_AT = {{ voo.startedAt|json_encode|raw }};
  // Telemetria REAL da aeronave (MSFS, via TelemetryDeriver) — usada só
  // pelo gráfico/marcadores de eventos no mapa; os indicadores em si já
  // vêm prontos do servidor acima (relatorio.indicadoresTelemetria).
  window.KATABATIC_TELEMETRIA = {{ telemetria|json_encode|raw }};
</script>
<script src="/assets/js/pages/pesquisa-cientifica.js" defer></script>
{% endblock %}
