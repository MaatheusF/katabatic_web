{% extends 'app_base.html.twig' %}

{% block title %}Manuais e Operações — Katabatic{% endblock %}
{% block meta_description %}Manuais e documentação de operação da Katabatic: fraseologia, procedimentos e técnica de voo.{% endblock %}

{% block page_stylesheets %}
<link rel="stylesheet" href="/assets/css/pages/manuais.css">
{% endblock %}

{% block bar %}
<div class="bar">
  <h1 id="title" data-i18n="manuais.hub.title">Manuais e Operações</h1>
  <div class="lang" role="group" aria-label="Idioma" data-i18n-attr="aria-label:a11y.language">
    <button type="button" data-lang="pt" aria-pressed="true">PT</button>
    <button type="button" data-lang="en" aria-pressed="false">EN</button>
  </div>
  <button class="icon-btn" id="theme" aria-label="Alternar tema" data-i18n-attr="aria-label:a11y.theme">
    <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  </button>
</div>
{% endblock %}

{% block content %}
<div class="wrap">
  <p class="intro" data-i18n="manuais.intro">Documentação de referência pra operar na Katabatic — fraseologia de rádio, procedimentos e técnica de voo específica das nossas rotas árticas e patagônicas. Ainda é um acervo pequeno; cresce conforme a rede evolui.</p>

  <div class="manuals-grid">
    {% for m in manuals %}
      {% if m.ready %}
      <a class="manual-card" href="{{ path(m.route) }}">
        <span class="tag" data-i18n="manuais.card.{{ m.key }}.tag">{{ m.tag }}</span>
        <h3 data-i18n="manuais.card.{{ m.key }}.title">{{ m.title }}</h3>
        <p data-i18n="manuais.card.{{ m.key }}.blurb">{{ m.blurb }}</p>
        <span class="cta" data-i18n="manuais.cta.open">Abrir manual <i>→</i></span>
      </a>
      {% else %}
      <div class="manual-card disabled">
        <span class="tag" data-i18n="manuais.card.{{ m.key }}.tag">{{ m.tag }}</span>
        <h3 data-i18n="manuais.card.{{ m.key }}.title">{{ m.title }}</h3>
        <p data-i18n="manuais.card.{{ m.key }}.blurb">{{ m.blurb }}</p>
        <span class="cta muted" data-i18n="manuais.cta.soon">Em breve</span>
      </div>
      {% endif %}
    {% endfor %}
  </div>
</div>
{% endblock %}

{% block page_javascripts %}
<script>
  (function () {
    var d = {
      'manuais.hub.title': 'Manuals and Operations',
      'manuais.intro': 'Reference documentation for operating at Katabatic — radio phraseology, procedures and flight technique specific to our Arctic and Patagonian routes. Still a small library; it grows as the network evolves.',
      'manuais.cta.open': 'Open manual <i>→</i>',
      'manuais.cta.soon': 'Coming soon',
      'manuais.card.fraseologia.title': 'VATSIM Phraseology',
      'manuais.card.fraseologia.tag': 'Communication',
      'manuais.card.fraseologia.blurb': 'Standard English UNICOM communications, by flight phase — from radio check to landing.',
      'manuais.card.ficha_voo.title': 'Flight sheet (kneeboard)',
      'manuais.card.ficha_voo.tag': 'Flight support',
      'manuais.card.ficha_voo.blurb': 'Printable PDF (3 flights per sheet) or editable spreadsheet, to jot down data during the flight.',
      'manuais.card.emergencia.title': 'Emergency procedures',
      'manuais.card.emergencia.tag': 'Safety',
      'manuais.card.emergencia.blurb': 'Checklists and phraseology for engine failure, forced landing, and Mayday/Pan-Pan calls.',
      'manuais.card.meteorologia.title': 'Polar weather',
      'manuais.card.meteorologia.tag': 'Weather',
      'manuais.card.meteorologia.blurb': 'How to read METAR/TAF and recognize risks specific to the Arctic and Patagonia.',
      'manuais.card.pistas.title': 'Unpaved runway operations',
      'manuais.card.pistas.tag': 'Flight technique',
      'manuais.card.pistas.blurb': 'Landing and takeoff on gravel, packed snow, and the short strips at the advanced stations.'
    };
    for (var k in d) { window.KATABATIC_I18N_EN[k] = d[k]; }
  })();
</script>
{% endblock %}
