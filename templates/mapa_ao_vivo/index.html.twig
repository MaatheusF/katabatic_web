{% extends 'app_base.html.twig' %}

{% block title %}Mapa ao vivo — Katabatic{% endblock %}
{% block meta_description %}Posição ao vivo (demonstração) de toda a frota Katabatic: aeronaves em voo e em solo.{% endblock %}

{% block map_assets %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" defer></script>
{% endblock %}

{% block page_stylesheets %}
<link rel="stylesheet" href="/assets/css/pages/mapa-ao-vivo.css">
{% endblock %}

{% block bar %}
<div class="bar">
  <h1 id="title">Mapa ao vivo</h1>
  <span class="map-live"><i></i><span data-i18n="mapavivo.live">AO VIVO</span></span>
  <span class="mv-clock mono" id="mv-clock">—</span>
  <div class="lang" role="group" aria-label="Idioma" data-i18n-attr="aria-label:a11y.language">
    <button type="button" data-lang="pt" aria-pressed="true">PT</button>
    <button type="button" data-lang="en" aria-pressed="false">EN</button>
  </div>
  <button class="icon-btn" id="theme" aria-label="Alternar tema" data-i18n-attr="aria-label:a11y.theme">
    <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  </button>
</div>
{% endblock %}

{% block content %}
<div class="mv-stage">
  <div id="mv-map"></div>

  <div class="mv-panel">
    <div class="mv-panel-h">
      <b data-i18n="mapavivo.panel.heading">Frota agora</b>
      <span class="mv-count" id="mv-fleet-count"></span>
    </div>

    <div class="mv-section">
      <span class="mv-section-t"><span data-i18n="common.status.inflight">Em voo</span> <b class="mono" id="mv-count-flying">—</b></span>
      <div id="mv-flying-list"></div>
    </div>

    <div class="mv-section">
      <span class="mv-section-t"><span data-i18n="mapavivo.onground">Em solo</span> <b class="mono" id="mv-count-parked">—</b></span>
      <div id="mv-parked-list"></div>
    </div>

    <p class="mv-note" data-i18n="mapavivo.note.sim">Posição em voo é uma simulação: repete em loop a telemetria de uma gravação real de cada aeronave (~5-6 min) sobre a rota planejada, já que ainda não existe um feed ao vivo via ACARS. Altitude/velocidade mostradas vêm dessa gravação real.</p>

    <div class="mv-wx-panel">
      <div class="mv-wx-row">
        <label class="mv-wx-toggle">
          <input type="checkbox" id="mv-radar-toggle" checked>
          <span id="mv-radar-label" data-i18n="mapavivo.radar.label">Radar de precipitação</span>
        </label>
        <button type="button" class="mv-wx-play" id="mv-radar-play" aria-pressed="false" data-i18n="mapavivo.radar.play">▶ Animar</button>
      </div>
      <span class="mv-wx-updated mono" id="mv-wx-updated"></span>
      <p class="mv-note" data-i18n="mapavivo.note.weather">Clima é dado real (não mock): condição por aeroporto via Open-Meteo, radar de precipitação via RainViewer — ambas gratuitas, sem chave. O radar abre parado no frame mais recente; "Animar" repete os últimos ~80 minutos observados. Cobertura de radar pode ser fraca em regiões remotas como o interior do Alasca e a Patagônia.</p>
    </div>
  </div>

  <div class="mv-legend">
    <span><i class="dot dot-fly"></i> <span data-i18n="common.status.inflight">Em voo</span></span>
    <span><i class="dot dot-ground"></i> <span data-i18n="mapavivo.onground">Em solo</span></span>
    <span><i class="dot" style="background:var(--accent)"></i> <span data-i18n="mapavivo.legend.rain">Chuva</span></span>
    <span><i class="dot" style="background:var(--ice)"></i> <span data-i18n="mapavivo.legend.snowfog">Neve/névoa</span></span>
    <span><i class="dot" style="background:var(--danger)"></i> <span data-i18n="mapavivo.legend.storm">Tempestade</span></span>
  </div>
</div>
{% endblock %}

{% block page_javascripts %}
<script>
  (function () {
    var d = {
      'mapavivo.panel.heading': 'Fleet now',
      'mapavivo.onground': 'On ground',
      'mapavivo.note.sim': 'In-flight position is a simulation: it loops the real recorded telemetry of each aircraft (~5-6 min) over the planned route, since there is no live ACARS feed yet. Altitude/speed shown come from that real recording.',
      'mapavivo.radar.label': 'Precipitation radar',
      'mapavivo.radar.play': '▶ Animate',
      'mapavivo.radar.pause': '⏸ Pause',
      'mapavivo.radar.unavailable': 'Radar unavailable',
      'mapavivo.note.weather': 'Weather is real (not mock) data: airport condition via Open-Meteo, precipitation radar via RainViewer — both free, no key required. The radar opens paused on the most recent frame; "Animate" loops the last ~80 observed minutes. Radar coverage may be weak in remote regions such as inland Alaska and Patagonia.',
      'mapavivo.legend.rain': 'Rain',
      'mapavivo.legend.snowfog': 'Snow/fog',
      'mapavivo.legend.storm': 'Storm',
      'mapavivo.kv.indicated': 'Indicated airspeed',
      'mapavivo.viewreport': 'View real report ↗',
      'mapavivo.popup.at': 'at',
      'mapavivo.popup.viewhistory': 'View history ↗',
      'mapavivo.wx.clear': 'Clear',
      'mapavivo.wx.cloudy': 'Cloudy',
      'mapavivo.wx.fog': 'Fog',
      'mapavivo.wx.drizzle': 'Drizzle',
      'mapavivo.wx.rain': 'Rain',
      'mapavivo.wx.snow': 'Snow',
      'mapavivo.wx.storm': 'Storm',
      'mapavivo.wx.condition': 'Condition',
      'mapavivo.wx.temperature': 'Temperature',
      'mapavivo.wx.wind': 'Wind',
      'mapavivo.wx.gust': 'Gust',
      'mapavivo.wx.caption': 'Real-time weather · Open-Meteo',
      'mapavivo.wx.updated': 'Weather updated',
      'mapavivo.flying.empty': 'No aircraft in flight right now.',
      'mapavivo.fleet.noun': 'aircraft',
      'mapavivo.map.unavailable': 'Map unavailable',
      'mapavivo.fetch.error': 'Could not load the map data.'
    };
    for (var k in d) { window.KATABATIC_I18N_EN[k] = d[k]; }
  })();
  window.KATABATIC_MV_FLYING = {{ liveFlights|json_encode|raw }};
  window.KATABATIC_MV_PARKED = {{ parkedAircraft|json_encode|raw }};
  window.KATABATIC_AIRPORTS_URL = {{ airportsUrl|json_encode|raw }};
  window.KATABATIC_FLIGHTS_URL = {{ flightsUrl|json_encode|raw }};
</script>
<script src="/assets/js/pages/mapa-ao-vivo.js" defer></script>
{% endblock %}
