{% extends 'base.html.twig' %}

{% block title %}Solicitação de adesão — Katabatic{% endblock %}
{% block meta_description %}Solicite adesão como piloto da Katabatic — companhia aérea virtual no MSFS 2024 e na rede VATSIM.{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="/assets/css/pages/adesao.css">
{% endblock %}

{% block body %}

<header class="topbar">
  <div class="wrap topbar-inner">
    <a class="brand" href="{{ path('app_home') }}">
      {% include 'partials/_brand.html.twig' %}
    </a>
    <div class="tools">
      <div class="lang" role="group" aria-label="Idioma" data-i18n-attr="aria-label:a11y.language">
        <button type="button" data-lang="pt" aria-pressed="true">PT</button>
        <button type="button" data-lang="en" aria-pressed="false">EN</button>
      </div>
      <button class="theme-toggle" id="theme" aria-label="Alternar tema" data-i18n-attr="aria-label:a11y.theme">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <a class="btn" href="{{ path('app_login') }}" data-i18n="nav.pilot">Área do piloto</a>
    </div>
  </div>
</header>

<div class="adesao-shell">
  <div class="adesao-card" id="adesao-form-card">
    <div class="adesao-head">
      {% include 'partials/_brand_icon.html.twig' %}
      <h1 data-i18n="adesao.title">Solicitação de adesão</h1>
      <p data-i18n="adesao.lead">A Katabatic não abre vagas em massa — toda entrada passa por três voos de avaliação. Preencha os dados abaixo pra começar; a gente responde por e-mail com os próximos passos.</p>
    </div>

    <div class="adesao-error" id="ad-error" style="display:none"></div>

    <form id="adesao-form" novalidate>
      <div class="grid2">
        <div class="field">
          <label for="ad-nome" data-i18n="adesao.nome.label">Nome completo</label>
          <input type="text" id="ad-nome" placeholder="Seu nome" data-i18n-attr="placeholder:adesao.nome.ph" required>
        </div>
        <div class="field">
          <label for="ad-email" data-i18n="adesao.email.label">E-mail</label>
          <input type="email" id="ad-email" placeholder="voce@exemplo.com" data-i18n-attr="placeholder:adesao.email.ph" required>
        </div>
      </div>

      <div class="grid2">
        <div class="field">
          <label for="ad-cid" data-i18n="adesao.cid.label">CID VATSIM</label>
          <input type="text" id="ad-cid" class="mono-input" inputmode="numeric" placeholder="1234567" required>
          <p class="hint" data-i18n="adesao.cid.hint">Ainda não tem? Crie uma conta gratuita em <a href="https://my.vatsim.net" target="_blank" rel="noopener">my.vatsim.net</a>.</p>
        </div>
        <div class="field">
          <label for="ad-discord" data-i18n="adesao.discord.label">ID do Discord <span class="opt">(opcional)</span></label>
          <input type="text" id="ad-discord" class="mono-input" placeholder="usuario" data-i18n-attr="placeholder:adesao.discord.ph">
          <p class="hint" data-i18n="adesao.discord.hint">Pra te adicionar no servidor da tripulação assim que aprovar.</p>
        </div>
      </div>

      <div class="field">
        <label data-i18n="adesao.exp.label">Experiência em voo simulado</label>
        <div class="chips" id="ad-exp-chips">
          <button class="chip on" data-exp="Iniciante" type="button" data-i18n="adesao.exp.beginner">Iniciante</button>
          <button class="chip" data-exp="Intermediário" type="button" data-i18n="adesao.exp.intermediate">Intermediário</button>
          <button class="chip" data-exp="Experiente" type="button" data-i18n="adesao.exp.experienced">Experiente</button>
        </div>
      </div>

      <div class="field">
        <label data-i18n="adesao.base.label">Base preferida</label>
        <div class="chips" id="ad-base-chips">
          <button class="chip on" data-base="PAFA" type="button">PAFA · Fairbanks</button>
          <button class="chip" data-base="SCCI" type="button">SCCI · Punta Arenas</button>
          <button class="chip" data-base="SLLP" type="button">SLLP · La Paz</button>
          <button class="chip" data-base="VNKT" type="button">VNKT · Catmandu</button>
          <button class="chip" data-base="WAJW" type="button">WAJW · Wamena</button>
          <button class="chip" data-base="VQPR" type="button">VQPR · Paro</button>
          <button class="chip" data-base="Sem preferência" type="button" data-i18n="adesao.base.none">Sem preferência</button>
        </div>
      </div>

      <div class="field">
        <label for="ad-conheceu" data-i18n="adesao.heard.label">Como conheceu a Katabatic <span class="opt">(opcional)</span></label>
        <select id="ad-conheceu">
          <option value="" data-i18n="adesao.heard.placeholder">Selecione…</option>
          <option data-i18n="adesao.heard.vatsim">Rede VATSIM</option>
          <option data-i18n="adesao.heard.discord">Discord</option>
          <option data-i18n="adesao.heard.referral">Indicação de outro piloto</option>
          <option data-i18n="adesao.heard.social">Redes sociais</option>
          <option data-i18n="adesao.heard.other">Outro</option>
        </select>
      </div>

      <div class="field">
        <label for="ad-motivacao" data-i18n="adesao.motivation.label">Por que quer voar na Katabatic?</label>
        <textarea id="ad-motivacao" rows="5" placeholder="Conte um pouco da sua experiência e o que te atraiu pra cá…" data-i18n-attr="placeholder:adesao.motivation.ph" required></textarea>
        <div class="charcount" id="ad-motivacao-count">0 caracteres</div>
      </div>

      <label class="agree">
        <input type="checkbox" id="ad-agree">
        <span data-i18n="adesao.agree">Li e concordo com os <a href="{{ path('app_home') }}#tripulacao">critérios de avaliação</a> da Katabatic.</span>
      </label>

      <button type="submit" class="btn btn-primary adesao-submit" id="ad-submit" disabled data-i18n="adesao.submit">Enviar solicitação</button>
    </form>
  </div>

  <div class="adesao-card" id="adesao-success-card" style="display:none">
    <div class="adesao-success-icon">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="var(--ok)" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
    </div>
    <h1 data-i18n="adesao.success.title">Solicitação enviada</h1>
    <p id="ad-success-summary"></p>
    <div class="adesao-note">
      <b data-i18n="adesao.success.note.title">Próximos passos</b>
      <span data-i18n="adesao.success.note.body">Seu pedido já está registrado e aparece no grid de Solicitações da tripulação — vamos revisar e responder por e-mail.</span>
    </div>
    <a class="btn" href="{{ path('app_home') }}" data-i18n="adesao.success.back">‹ Voltar para a home</a>
  </div>
</div>

{% endblock %}

