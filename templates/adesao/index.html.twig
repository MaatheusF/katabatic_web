{% extends 'base.html.twig' %}

{% block title %}Solicitação de adesão — Katabatic{% endblock %}
{% block meta_description %}Solicite adesão como piloto da Katabatic — companhia aérea virtual no MSFS 2024 e na rede VATSIM.{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="/assets/css/pages/adesao.css">
{% endblock %}

{% block body %}

<header class="topbar">
  <div class="wrap topbar-inner">
    <a class="brand" href="{{ path('app_home') }}">
      {% include 'partials/_brand.html.twig' %}
    </a>
    <div class="tools">
      <div class="lang" role="group" aria-label="Idioma">
        <button type="button" data-lang="pt" aria-pressed="true">PT</button>
        <button type="button" data-lang="en" aria-pressed="false">EN</button>
      </div>
      <button class="theme-toggle" id="theme" aria-label="Alternar tema">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <a class="btn" href="{{ path('app_login') }}" data-i18n="nav.pilot">Área do piloto</a>
    </div>
  </div>
</header>

<div class="adesao-shell">
  <div class="adesao-card" id="adesao-form-card">
    <div class="adesao-head">
      {% include 'partials/_brand_icon.html.twig' %}
      <h1>Solicitação de adesão</h1>
      <p>A Katabatic não abre vagas em massa — toda entrada passa por três voos de avaliação. Preencha os dados abaixo pra começar; a gente responde por e-mail com os próximos passos.</p>
    </div>

    <form id="adesao-form" novalidate>
      <div class="grid2">
        <div class="field">
          <label for="ad-nome">Nome completo</label>
          <input type="text" id="ad-nome" placeholder="Seu nome" required>
        </div>
        <div class="field">
          <label for="ad-email">E-mail</label>
          <input type="email" id="ad-email" placeholder="voce@exemplo.com" required>
        </div>
      </div>

      <div class="grid2">
        <div class="field">
          <label for="ad-cid">CID VATSIM</label>
          <input type="text" id="ad-cid" class="mono-input" inputmode="numeric" placeholder="1234567" required>
          <p class="hint">Ainda não tem? Crie uma conta gratuita em <a href="https://my.vatsim.net" target="_blank" rel="noopener">my.vatsim.net</a>.</p>
        </div>
        <div class="field">
          <label for="ad-discord">ID do Discord <span class="opt">(opcional)</span></label>
          <input type="text" id="ad-discord" class="mono-input" placeholder="usuario">
          <p class="hint">Pra te adicionar no servidor da tripulação assim que aprovar.</p>
        </div>
      </div>

      <div class="field">
        <label>Experiência em voo simulado</label>
        <div class="chips" id="ad-exp-chips">
          <button class="chip on" data-exp="Iniciante" type="button">Iniciante</button>
          <button class="chip" data-exp="Intermediário" type="button">Intermediário</button>
          <button class="chip" data-exp="Experiente" type="button">Experiente</button>
        </div>
      </div>

      <div class="field">
        <label>Base preferida</label>
        <div class="chips" id="ad-base-chips">
          <button class="chip on" data-base="PAFA" type="button">PAFA · Fairbanks</button>
          <button class="chip" data-base="SCCI" type="button">SCCI · Punta Arenas</button>
          <button class="chip" data-base="Sem preferência" type="button">Sem preferência</button>
        </div>
      </div>

      <div class="field">
        <label for="ad-conheceu">Como conheceu a Katabatic <span class="opt">(opcional)</span></label>
        <select id="ad-conheceu">
          <option value="">Selecione…</option>
          <option>Rede VATSIM</option>
          <option>Discord</option>
          <option>Indicação de outro piloto</option>
          <option>Redes sociais</option>
          <option>Outro</option>
        </select>
      </div>

      <div class="field">
        <label for="ad-motivacao">Por que quer voar na Katabatic?</label>
        <textarea id="ad-motivacao" rows="5" placeholder="Conte um pouco da sua experiência e o que te atraiu pra cá…" required></textarea>
        <div class="charcount" id="ad-motivacao-count">0 caracteres</div>
      </div>

      <label class="agree">
        <input type="checkbox" id="ad-agree">
        <span>Li e concordo com os <a href="{{ path('app_home') }}#tripulacao">critérios de avaliação</a> da Katabatic.</span>
      </label>

      <button type="submit" class="btn btn-primary adesao-submit" id="ad-submit" disabled>Enviar solicitação</button>
    </form>
  </div>

  <div class="adesao-card" id="adesao-success-card" style="display:none">
    <div class="adesao-success-icon">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="var(--ok)" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
    </div>
    <h1>Solicitação enviada</h1>
    <p id="ad-success-summary"></p>
    <div class="adesao-note">
      <b>Ambiente de desenvolvimento</b>
      <span>Este envio ainda é simulado (sem backend de verdade) — não fica gravado, então não aparece automaticamente no grid de Solicitações da área logada. Vira um POST de verdade quando o schema do banco existir.</span>
    </div>
    <a class="btn" href="{{ path('app_home') }}">‹ Voltar para a home</a>
  </div>
</div>

{% endblock %}

{% block javascripts %}
<script>
  window.KATABATIC_I18N_EN = {
    'nav.pilot': 'Pilot area'
  };
</script>
<script src="/assets/js/pages/adesao.js" defer></script>
{% endblock %}
