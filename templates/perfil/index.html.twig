{% extends 'app_base.html.twig' %}

{% block title %}Perfil — Katabatic{% endblock %}
{% block meta_description %}Configurações do perfil do piloto Katabatic: nome, e-mail e foto.{% endblock %}

{% block page_stylesheets %}
<link rel="stylesheet" href="/assets/css/pages/perfil.css">
{% endblock %}

{% block bar %}
<div class="bar">
  <a class="back" href="{{ path('app_portal') }}"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg><span data-i18n="rail.logbook">Logbook</span></a>
  <span class="sep">/</span>
  <h1 data-i18n="perfil.title">Perfil</h1>
  <div class="right">
    <div class="lang" role="group" aria-label="Idioma" data-i18n-attr="aria-label:a11y.language">
      <button type="button" data-lang="pt" aria-pressed="true">PT</button>
      <button type="button" data-lang="en" aria-pressed="false">EN</button>
    </div>
    <button class="icon-btn" id="theme" aria-label="Tema" data-i18n-attr="aria-label:a11y.theme">
      <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
  </div>
</div>
{% endblock %}

{% block content %}
<div class="wrap">

  {% if errors is defined and errors is not empty %}
  {% set perfilErrorKeys = {
    'Informe seu nome.': 'perfil.error.name',
    'Informe um e-mail válido.': 'perfil.error.email',
    'Não foi possível ler o arquivo de foto enviado — tente novamente.': 'perfil.error.photo.unreadable',
    'Formato de imagem não suportado — envie um arquivo JPG, PNG ou WEBP.': 'perfil.error.photo.format',
    'A imagem enviada é muito grande — o limite é 3 MB.': 'perfil.error.photo.size',
    'Não foi possível salvar a foto enviada — tente novamente.': 'perfil.error.photo.savefail'
  } %}
  <div class="perfil-errors">
    <ul>
      {% for error in errors %}
      <li data-i18n="{{ perfilErrorKeys[error]|default('') }}">{{ error }}</li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}

  <form method="post" action="{{ path('app_perfil_update') }}" enctype="multipart/form-data" id="perfil-form">

    <!-- Foto -->
    <div class="card">
      <div class="card-h"><span class="n">1</span><h3 data-i18n="perfil.photo.title">Foto de exibição</h3><span class="note" data-i18n="perfil.photo.note">JPG, PNG ou WEBP · máx. 3 MB</span></div>
      <div class="card-b">
        <div class="avatar-row">
          <div class="avatar-preview" id="avatar-preview">
            {% if pilot.photo %}
            <img src="{{ pilot.photo }}" alt="" id="avatar-img">
            {% else %}
            <span id="avatar-fallback">{{ pilot.initials }}</span>
            <img src="" alt="" id="avatar-img" hidden>
            {% endif %}
          </div>
          <div class="avatar-upload">
            <label class="btn" for="f-photo" data-i18n="perfil.photo.choose">Escolher foto…</label>
            <input type="file" id="f-photo" name="photo" accept="image/jpeg,image/png,image/webp" hidden>
            <p class="hint" id="avatar-filename" data-i18n="perfil.photo.hint">Nenhum arquivo novo selecionado — a foto atual é mantida.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Dados pessoais -->
    <div class="card">
      <div class="card-h"><span class="n">2</span><h3 data-i18n="perfil.personal.title">Dados pessoais</h3></div>
      <div class="card-b">
        <div class="grid2">
          <div class="field">
            <label for="f-name" data-i18n="perfil.name">Nome</label>
            <input type="text" id="f-name" name="name" value="{{ pilot.name }}" required autofocus>
          </div>
          <div class="field">
            <label for="f-email" data-i18n="perfil.email">E-mail</label>
            <input type="email" id="f-email" name="email" value="{{ pilot.email|default('') }}" required>
          </div>
        </div>
      </div>
    </div>

    <!-- Conta -->
    <div class="card">
      <div class="card-h"><span class="n">3</span><h3 data-i18n="perfil.account.title">Conta</h3><span class="note" data-i18n="perfil.account.note">gerenciado pela VATSIM, não editável aqui</span></div>
      <div class="card-b">
        <div class="grid2">
          <div class="field">
            <label data-i18n="perfil.cid">CID VATSIM</label>
            <input type="text" class="mono-input" value="{{ pilot.cid }}" readonly>
          </div>
          <div class="field">
            <label data-i18n="perfil.role">Papel</label>
            <input type="text" value="{{ pilot.admin ? 'Administrador' : 'Piloto' }}" data-i18n-attr="value:{{ pilot.admin ? 'perfil.role.admin' : 'perfil.role.pilot' }}" readonly>
          </div>
        </div>
      </div>
    </div>

    <div class="footer-actions">
      <a class="btn btn-ghost" href="{{ path('app_portal') }}" data-i18n="common.cancel">Cancelar</a>
      <div class="right">
        <button type="submit" class="btn btn-primary" data-i18n="perfil.save">Salvar alterações</button>
      </div>
    </div>

  </form>

</div>
{% endblock %}

{% block page_javascripts %}
<script>
  (function () {
    // Dicionario EN especifico do Perfil - complementa o dicionario global
    // (definido em app_base.html.twig). So o que falta la: as mensagens de
    // validacao vindas de PerfilController (mapeadas por texto exato no
    // loop de errors do template, ver perfilErrorKeys acima) e o valor do
    // campo somente-leitura "Papel".
    var d = {
      'perfil.error.name': 'Please enter your name.',
      'perfil.error.email': 'Please enter a valid e-mail.',
      'perfil.error.photo.unreadable': "Couldn't read the uploaded photo file — please try again.",
      'perfil.error.photo.format': 'Unsupported image format — please upload a JPG, PNG or WEBP file.',
      'perfil.error.photo.size': 'The uploaded image is too large — the limit is 3 MB.',
      'perfil.error.photo.savefail': "Couldn't save the uploaded photo — please try again.",
      'perfil.role.admin': 'Administrator',
      'perfil.role.pilot': 'Pilot'
    };
    for (var k in d) { window.KATABATIC_I18N_EN[k] = d[k]; }
  })();
</script>
<script src="/assets/js/pages/perfil.js" defer></script>
{% endblock %}
