{% extends 'app_base.html.twig' %}

{% block title %}Katabatic — Área do piloto{% endblock %}

{% block page_stylesheets %}
<link rel="stylesheet" href="/assets/css/pages/portal.css">
{% endblock %}

{% block bar %}
<div class="bar">
  <h1 id="title">Logbook</h1>
  <div class="lang" role="group" aria-label="Idioma">
    <button type="button" data-lang="pt" aria-pressed="true">PT</button>
    <button type="button" data-lang="en" aria-pressed="false">EN</button>
  </div>
  <button class="icon-btn" id="theme" aria-label="Alternar tema">
    <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  </button>
  <a class="btn btn-primary" href="{{ path('app_novo_voo') }}" data-i18n="nav.newflight">Novo voo</a>
</div>
{% endblock %}

{% block content %}

<!-- ================= LOGBOOK ================= -->
<section class="view on" id="v-logbook">
  <div class="summary">
    <div><b class="mono">{{ logbookSummary.hours }}<small> h</small></b><span>Horas registradas</span></div>
    <div><b class="mono" id="sum-count">{{ logbookSummary.flights }}</b><span>Voos concluídos</span></div>
    <div><b class="mono">{{ logbookSummary.avgDifficulty }}</b><span>Dificuldade média</span></div>
    <div><b class="mono">{{ logbookSummary.vatsimPct }}<small>%</small></b><span>Na rede VATSIM</span></div>
  </div>

  <div class="filters">
    <button class="chip on" data-tipo="Todos">Todos</button>
    <button class="chip" data-tipo="Carga">Carga</button>
    <button class="chip" data-tipo="Pessoal">Pessoal</button>
    <button class="chip" data-tipo="Pesquisa">Pesquisa</button>
    <button class="chip" data-tipo="Reposicionamento">Reposicionamento</button>
    <select id="periodo" class="lbsel">
      <option value="0">Todo o período</option>
      <option value="7">Últimos 7 dias</option>
      <option value="30" selected>Últimos 30 dias</option>
      <option value="90">Últimos 90 dias</option>
    </select>
    <input id="busca" class="lbsearch" type="text" placeholder="Buscar callsign, rota ou ICAO…">
    <div class="viewtoggle">
      <button class="vt on" id="vt-normal" title="Linhas normais">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <button class="vt" id="vt-dense" title="Linhas compactas">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 5h16M4 9.5h16M4 14h16M4 18.5h16"/></svg>
      </button>
    </div>
    <span class="right" id="filter-count">{{ logbook|length }} voos</span>
  </div>

  <div class="card">
    <div class="table-scroll" id="lb-scroll">
      <table id="lb-table">
        <thead>
          <tr>
            <th data-sort="data" class="sortable">Data <i class="arw">▾</i></th>
            <th>Voo</th><th>Rota</th><th>Aeronave</th>
            <th class="num sortable" data-sort="tempo">Tempo</th>
            <th>Condição</th><th>Ocorrência</th>
            <th class="num sortable" data-sort="dificuldade">Dificuldade <i class="arw"></i></th>
          </tr>
        </thead>
        <tbody id="lb-body"></tbody>
      </table>
      <div class="empty" id="lb-empty" style="display:none">Nenhum voo encontrado com esses filtros.</div>
    </div>
    <div class="pager" id="lb-pager" style="display:none">
      <button class="btn" id="lb-prev" type="button">‹ Anterior</button>
      <span class="pager-info" id="lb-pageinfo"></span>
      <button class="btn" id="lb-next" type="button">Próxima ›</button>
    </div>
  </div>
</section>

<!-- ================= FROTA ================= -->
<section class="view" id="v-frota">
  <div class="summary">
    <div><b class="mono">{{ fleetSummary.count }}</b><span>Aeronaves</span></div>
    <div><b class="mono">{{ fleetSummary.totalHours }}<small> h</small></b><span>Horas totais</span></div>
    <div><b class="mono">{{ fleetSummary.inFlight }}</b><span>Em voo agora</span></div>
    <div><b class="mono">{{ fleetSummary.away }}</b><span>Fora de base</span></div>
  </div>

  <div class="filters">
    <button class="chip on" data-base="Todas">Todas</button>
    <button class="chip" data-base="PAFA">PAFA</button>
    <button class="chip" data-base="SCCI">SCCI</button>
    <div class="viewtoggle">
      <button class="vt on" id="vt-grid" title="Visualização em grade">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/><rect x="13" y="13" width="8" height="8" rx="1.5"/></svg>
      </button>
      <button class="vt" id="vt-list" title="Visualização em lista">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
    <span class="right">
      <span>Registro CC no sul · N no norte</span>
      <a class="btn btn-primary" href="{{ path('app_nova_aeronave') }}" data-i18n="portal.newaircraft">+ Nova aeronave</a>
    </span>
  </div>

  <div class="fleet-grid" id="fleet-grid"></div>
  <div class="card" id="fleet-list" style="display:none">
    <table>
      <thead><tr><th>Matrícula</th><th>Tipo</th><th>Status</th><th>Base</th><th>Posição</th><th class="num">Horas</th><th>Último voo</th><th>Histórico</th></tr></thead>
      <tbody id="fleet-list-body"></tbody>
    </table>
  </div>
</section>

<!-- ================= BASES ================= -->
<section class="view" id="v-bases">
  <div class="bases">
    {% for base in [bases.north, bases.south] %}
    <article class="base">
      <div class="base-head"><b>{{ base.icao }}</b><span>{{ base.name }}</span><span class="tag">{{ base.tag }}</span></div>
      <p style="color:var(--text-2); font-size:14px">{{ base.blurb }}</p>
      <div class="metrics">
        <div><span>Vento</span><b{% if base.windWarn %} class="warn"{% endif %}>{{ base.wind }}</b></div>
        <div><span>Temp</span><b>{{ base.temp }}</b></div>
        <div><span>Visib.</span><b{% if base.visWarn %} class="warn"{% endif %}>{{ base.vis }}</b></div>
        <div><span>Teto</span><b>{{ base.ceil }}</b></div>
      </div>
      <span class="stn-label">Estações avançadas · {{ base.stations|length }}</span>
      <div class="stns">
        {% for station in base.stations %}
        <div class="stn"><span class="dot" style="background:var(--{{ station.dot }})"></span><b>{{ station.icao }}</b><span>{{ station.name }}</span><span class="dist">{{ station.dist }}</span></div>
        {% endfor %}
      </div>
    </article>
    {% endfor %}
  </div>
</section>

{% endblock %}

{% block page_javascripts %}
<script>
  window.KATABATIC_LB = {{ logbook|json_encode|raw }};
  window.KATABATIC_FLEET = {{ fleet|json_encode|raw }};
  window.KATABATIC_NOW = {{ nowIso|json_encode|raw }};
</script>
<script src="/assets/js/pages/portal.js" defer></script>
{% endblock %}
