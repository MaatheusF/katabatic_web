{% extends 'app_base.html.twig' %}

{% block title %}Katabatic — Área do piloto{% endblock %}

{% block page_stylesheets %}
<link rel="stylesheet" href="/assets/css/pages/portal.css">
{% endblock %}

{% block bar %}
<div class="bar">
  <h1 id="title">Logbook</h1>
  <div class="lang" role="group" aria-label="Idioma" data-i18n-attr="aria-label:a11y.language">
    <button type="button" data-lang="pt" aria-pressed="true">PT</button>
    <button type="button" data-lang="en" aria-pressed="false">EN</button>
  </div>
  <button class="icon-btn" id="theme" aria-label="Alternar tema" data-i18n-attr="aria-label:a11y.theme">
    <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  </button>
  <a class="btn btn-primary" href="{{ path('app_novo_voo') }}" data-i18n="nav.newflight">Novo voo</a>
</div>
{% endblock %}

{% block content %}

<!-- ================= LOGBOOK ================= -->
<section class="view on" id="v-logbook">
  <div class="summary summary-3">
    <div><b class="mono">{{ logbookSummary.hours }}<small> h</small></b><span data-i18n="portal.hourslogged">Horas registradas</span></div>
    <div><b class="mono" id="sum-count">{{ logbookSummary.flights }}</b><span data-i18n="portal.flightscompleted">Voos concluídos</span></div>
    <div><b class="mono">{{ logbookSummary.avgDifficulty }}</b><span data-i18n="portal.avgdifficulty">Dificuldade média</span></div>
  </div>

  <div class="filters">
    <button class="chip on" data-tipo="Todos" data-i18n="common.all">Todos</button>
    <button class="chip" data-tipo="Carga" data-i18n="common.optype.cargo">Carga</button>
    <button class="chip" data-tipo="Pessoal" data-i18n="common.optype.personal">Pessoal</button>
    <button class="chip" data-tipo="Pesquisa" data-i18n="common.optype.research">Pesquisa</button>
    <button class="chip" data-tipo="Reposicionamento" data-i18n="common.optype.repositioning">Reposicionamento</button>
    <select id="periodo" class="lbsel">
      <option value="0" data-i18n="common.period.all">Todo o período</option>
      <option value="7" data-i18n="common.period.7d">Últimos 7 dias</option>
      <option value="30" selected data-i18n="common.period.30d">Últimos 30 dias</option>
      <option value="90" data-i18n="common.period.90d">Últimos 90 dias</option>
    </select>
    <input id="busca" class="lbsearch" type="text" placeholder="Buscar callsign, rota ou ICAO…" data-i18n-attr="placeholder:portal.search.placeholder">
    <div class="viewtoggle">
      <button class="vt on" id="vt-normal" title="Linhas normais" data-i18n-attr="title:portal.rows.normal">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <button class="vt" id="vt-dense" title="Linhas compactas" data-i18n-attr="title:portal.rows.dense">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 5h16M4 9.5h16M4 14h16M4 18.5h16"/></svg>
      </button>
    </div>
    <span class="right" id="filter-count">{{ logbook|length }} voos</span>
  </div>

  <!-- ================= ESTATÍSTICAS AGREGADAS (recalcula com os filtros acima) ================= -->
  <div class="card lb-stats-card" id="lb-stats">
    <div class="card-h"><h3 data-i18n="portal.stats.title">Estatísticas do período filtrado</h3><span class="note" id="lbst-note"></span></div>
    <div class="lb-stats-tiles">
      <div><b class="mono" id="lbst-dist">—</b><span data-i18n="portal.stats.distance">Distância voada</span></div>
      <div><b class="mono" id="lbst-fuel">—</b><span data-i18n="portal.stats.fuel">Combustível consumido</span></div>
      <div><b class="mono" id="lbst-airground">—</b><span data-i18n="portal.airground">Tempo ar / solo</span></div>
      <div><b class="mono" id="lbst-occ">—</b><span data-i18n="portal.stats.occurrences">Voos com ocorrência</span></div>
    </div>
    <div class="lb-stats-top">
      <div><span data-i18n="portal.stats.toproute">Rota mais voada</span><b id="lbst-route">—</b></div>
      <div><span data-i18n="portal.stats.topaircraft">Aeronave com mais horas</span><b id="lbst-aircraft">—</b></div>
      <div><span data-i18n="portal.stats.topcond">Condição mais comum</span><b id="lbst-cond">—</b></div>
    </div>
    <div class="lb-trend">
      <span data-i18n="portal.trend.title">Tendência de dificuldade <small>(ordem cronológica, mais antigo → mais recente)</small></span>
      <div class="lb-trend-bars" id="lb-trend-bars"></div>
    </div>
  </div>

  <div class="card">
    <div class="table-scroll" id="lb-scroll">
      <table id="lb-table">
        <thead>
          <tr>
            <th class="lb-expand-col"></th>
            <th data-sort="data" class="sortable"><span data-i18n="common.date">Data</span> <i class="arw">▾</i></th>
            <th data-i18n="portal.th.flight">Voo</th><th data-i18n="common.route">Rota</th><th data-i18n="common.aircraft">Aeronave</th>
            <th class="num sortable" data-sort="tempo" data-i18n="common.time">Tempo</th>
            <th data-i18n="portal.th.condition">Condição</th><th data-i18n="portal.th.occurrence">Ocorrência</th>
            <th class="num sortable" data-sort="dificuldade"><span data-i18n="portal.th.difficulty">Dificuldade</span> <i class="arw"></i></th>
          </tr>
        </thead>
        <tbody id="lb-body"></tbody>
      </table>
      <div class="empty" id="lb-empty" style="display:none" data-i18n="portal.empty">Nenhum voo encontrado com esses filtros.</div>
    </div>
    <div class="pager" id="lb-pager" style="display:none">
      <button class="btn" id="lb-prev" type="button" data-i18n="portal.pager.prev">‹ Anterior</button>
      <span class="pager-info" id="lb-pageinfo"></span>
      <button class="btn" id="lb-next" type="button" data-i18n="portal.pager.next">Próxima ›</button>
    </div>
  </div>
</section>

<!-- ================= FROTA ================= -->
<section class="view" id="v-frota">
  <div class="summary">
    <div><b class="mono">{{ fleetSummary.count }}</b><span data-i18n="common.aircraft">Aeronaves</span></div>
    <div><b class="mono">{{ fleetSummary.totalHours }}<small> h</small></b><span data-i18n="portal.fleet.totalhours">Horas totais</span></div>
    <div><b class="mono">{{ fleetSummary.inFlight }}</b><span data-i18n="portal.fleet.inflightnow">Em voo agora</span></div>
    <div><b class="mono">{{ fleetSummary.away }}</b><span data-i18n="portal.fleet.awaylabel">Fora de base</span></div>
  </div>

  <div class="filters">
    <button class="chip on" data-base="Todas" data-i18n="common.all">Todas</button>
    <button class="chip" data-base="PAFA">PAFA</button>
    <button class="chip" data-base="SCCI">SCCI</button>
    <button class="chip" data-base="SLLP">SLLP</button>
    <button class="chip" data-base="VNKT">VNKT</button>
    <button class="chip" data-base="WAJW">WAJW</button>
    <button class="chip" data-base="VQPR">VQPR</button>
    <div class="viewtoggle">
      <button class="vt on" id="vt-grid" title="Visualização em grade" data-i18n-attr="title:portal.fleet.view.grid">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/><rect x="13" y="13" width="8" height="8" rx="1.5"/></svg>
      </button>
      <button class="vt" id="vt-list" title="Visualização em lista" data-i18n-attr="title:portal.fleet.view.list">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
    <span class="right">
      <span data-i18n="portal.fleet.reghint">Registro CC no sul · N no norte</span>
      <a class="btn btn-primary" href="{{ path('app_nova_aeronave') }}" data-i18n="portal.newaircraft">+ Nova aeronave</a>
    </span>
  </div>

  <div class="fleet-grid" id="fleet-grid"></div>
  <div class="card" id="fleet-list" style="display:none">
    <table>
      <thead><tr><th data-i18n="portal.th.registration">Matrícula</th><th data-i18n="portal.th.type">Tipo</th><th>Status</th><th data-i18n="portal.th.base">Base</th><th data-i18n="portal.th.position">Posição</th><th class="num" data-i18n="common.hours">Horas</th><th data-i18n="portal.th.lastflight">Último voo</th><th data-i18n="portal.fleet.notes">Observações</th><th data-i18n="portal.th.history">Histórico</th></tr></thead>
      <tbody id="fleet-list-body"></tbody>
    </table>
  </div>
</section>

<!-- ================= BASES ================= -->
<section class="view" id="v-bases">
  <p class="wx-note" data-i18n="portal.bases.wx.caption">Clima é dado real (não mock), via Open-Meteo — mesma fonte do Mapa ao vivo. "Nuvens baixas" é cobertura de nuvem baixa em % (não existe altura de teto na API), então substitui o "Teto" que antes era só um número inventado.</p>
  <div class="bases">
    {% for base in bases %}
    <article class="base">
      <div class="base-head"><b>{{ base.icao }}</b><span>{{ base.name }}</span><span class="tag" data-i18n="portal.base.{{ base.icao|lower }}.tag">{{ base.tag }}</span></div>
      <p style="color:var(--text-2); font-size:14px">{{ base.blurb }}</p>
      <div class="metrics">
        <div><span data-i18n="portal.bases.wind">Vento</span><b id="base-wind-{{ base.icao }}">—</b></div>
        <div><span>Temp</span><b id="base-temp-{{ base.icao }}">—</b></div>
        <div><span data-i18n="portal.bases.vis">Visib.</span><b id="base-vis-{{ base.icao }}">—</b></div>
        <div><span data-i18n="portal.bases.lowcloud">Nuvens baixas</span><b id="base-cloud-{{ base.icao }}">—</b></div>
      </div>
      <span class="stn-label"><span data-i18n="portal.bases.stations">Estações avançadas</span> · {{ base.stations|length }}</span>
      <div class="stns">
        {% for station in base.stations %}
        <div class="stn"><span class="dot" id="stn-dot-{{ base.icao }}-{{ station.icao }}" style="background:var(--muted)"></span><b>{{ station.icao }}</b><span>{{ station.name }}</span><span class="dist">{{ station.dist }}</span></div>
        {% endfor %}
      </div>
    </article>
    {% endfor %}
  </div>
</section>

<!-- ================= POUSOS ================= -->
<section class="view" id="v-pousos">
  <p class="intro" data-i18n="pousos.intro">Todo toque com telemetria registrada, entre todos os voos com ACARS gravado — não só o mais recente. Sem filtro nesta primeira versão; clique numa linha pra abrir o relatório completo daquele voo.</p>
  <div class="card">
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th data-i18n="common.date">Data</th>
            <th data-i18n="portal.th.flight">Voo</th>
            <th data-i18n="common.route">Rota</th>
            <th data-i18n="common.aircraft">Aeronave</th>
            <th class="num" data-i18n="pousos.th.vs">VS de toque</th>
            <th class="num" data-i18n="pousos.th.pitch">Pitch</th>
            <th class="num" data-i18n="pousos.th.bank">Bank</th>
            <th data-i18n="pousos.th.surface">Superfície</th>
            <th data-i18n="pousos.th.class">Classificação</th>
          </tr>
        </thead>
        <tbody id="pousos-body">
          {% for p in pousos %}
          <tr{% if p.flightId %} data-flight-id="{{ p.flightId }}" tabindex="0"{% endif %}>
            <td>{{ p.data }} <span class="sub">{{ p.hora }}</span></td>
            <td class="mono">{{ p.callsign }}{% if p.acidentado %} <span class="tag tag-bad" data-i18n="voo.crash.badge">Acidentado</span>{% endif %}</td>
            <td class="route">{{ p.origem }}<i></i>{{ p.pouso }}{% if p.diversao %} <span class="tag tag-warn" data-i18n="pousos.diversion">Alternativo</span>{% endif %}</td>
            <td>{{ p.aeronave }}{% if p.modelo %} <span class="sub">{{ p.modelo }}</span>{% endif %}</td>
            <td class="num mono">{{ p.vs }} <small>fpm</small></td>
            <td class="num mono">{{ p.pitch is not null ? p.pitch ~ '°' : '—' }}</td>
            <td class="num mono">{{ p.bank is not null ? p.bank ~ '°' : '—' }}</td>
            <td>{{ p.superficie ?? '—' }}{% if p.condicaoSuperficie and p.condicaoSuperficie != 'Normal' %} <span class="sub">{{ p.condicaoSuperficie }}</span>{% endif %}</td>
            <td>
              {% if p.classificacao == 'duro' %}<span class="tag tag-bad" data-i18n="pousos.class.duro">Duro</span>
              {% elseif p.classificacao == 'normal' %}<span class="tag tag-warn" data-i18n="pousos.class.normal">Normal</span>
              {% else %}<span class="tag tag-ok" data-i18n="pousos.class.suave">Suave</span>{% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% if pousos is empty %}
      <div class="empty" data-i18n="pousos.empty">Nenhum pouso com telemetria registrada ainda.</div>
      {% endif %}
    </div>
  </div>
</section>

<!-- ================= CONDIÇÕES EXTREMAS ================= -->
<section class="view" id="v-condicoes">
  <p class="intro" data-i18n="condicoes.intro">Eventos marcados como atenção ou excedência em qualquer voo com telemetria — gelo, toque duro, overspeed, estol, taxa de simulação alterada e afins. Mesmo critério que já classifica cada evento dentro do relatório individual, só que somado entre todos os voos.</p>
  <div class="card">
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th data-i18n="common.date">Data</th>
            <th data-i18n="portal.th.flight">Voo</th>
            <th data-i18n="common.route">Rota</th>
            <th data-i18n="condicoes.th.event">Evento</th>
            <th data-i18n="condicoes.th.detail">Detalhe</th>
            <th data-i18n="condicoes.th.severity">Severidade</th>
          </tr>
        </thead>
        <tbody id="condicoes-body">
          {% for c in condicoes %}
          <tr{% if c.flightId %} data-flight-id="{{ c.flightId }}" tabindex="0"{% endif %}>
            <td>{{ c.data }} <span class="sub">{{ c.hora }}</span></td>
            <td class="mono">{{ c.callsign }}{% if c.acidentado %} <span class="tag tag-bad" data-i18n="voo.crash.badge">Acidentado</span>{% endif %}</td>
            <td class="mono">{{ c.rota }}</td>
            <td>{{ c.rotulo }}</td>
            <td class="sub">{{ c.detalhe }}</td>
            <td>{% if c.severidade == 'bad' %}<span class="tag tag-bad" data-i18n="condicoes.sev.bad">Excedência</span>{% else %}<span class="tag tag-warn" data-i18n="condicoes.sev.warn">Atenção</span>{% endif %}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% if condicoes is empty %}
      <div class="empty" data-i18n="condicoes.empty">Nenhuma condição extrema registrada ainda.</div>
      {% endif %}
    </div>
  </div>
</section>

{% endblock %}

