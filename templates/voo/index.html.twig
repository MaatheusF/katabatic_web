{% extends 'app_base.html.twig' %}

{% block title %}Relatório de voo — Katabatic{% endblock %}
{% block meta_description %}Relatório de voo Katabatic: telemetria, fases, mapa e debrief.{% endblock %}

{% block map_assets %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" defer></script>
{% endblock %}

{% block page_stylesheets %}
<link rel="stylesheet" href="/assets/css/pages/voo.css">
{% endblock %}

{% block bar %}
<div class="bar">
  <a class="back" href="{{ path('app_portal') }}"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg><span data-i18n="rail.logbook">Logbook</span></a>
  <span class="sep">/</span>
  <h1 id="h-call">—</h1>
  <div class="right">
    <div class="lang" role="group" aria-label="Idioma" data-i18n-attr="aria-label:a11y.language">
      <button type="button" data-lang="pt" aria-pressed="true">PT</button>
      <button type="button" data-lang="en" aria-pressed="false">EN</button>
    </div>
    <button class="icon-btn" id="prevf" aria-label="Voo anterior" title="Voo anterior" data-i18n-attr="aria-label:voo.nav.prev;title:voo.nav.prev">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <button class="icon-btn" id="nextf" aria-label="Próximo voo" title="Próximo voo" data-i18n-attr="aria-label:voo.nav.next;title:voo.nav.next">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
    </button>
    <button class="icon-btn" id="theme" aria-label="Tema" data-i18n-attr="aria-label:a11y.theme">
      <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
    <button class="btn" data-i18n="voo.share">Compartilhar</button>
  </div>
</div>
{% endblock %}

{% block content %}
<div class="wrap">
  <div>
    <div class="hero">
      <div>
        <div class="rt" id="h-route"><span id="h-route-text">UEEE <i></i> UEEE</span><span class="tag tag-bad" id="crash-badge" style="display:none" data-i18n="voo.crash.badge">Acidentado</span><span class="tag tag-warn" id="diversion-badge" style="display:none"></span></div>
        <p class="meta" id="h-meta"></p>
        <p class="meta">C185F Skywagon · N104KT · voo local de avaliação</p>
      </div>
      <div class="score"><span data-i18n="voo.difficulty">Dificuldade</span><b id="score">--</b><em id="score-lbl"></em></div>
    </div>

    <div class="kpis" id="kpis"></div>

    <div class="card">
      <div class="card-h"><h3 data-i18n="voo.phases.title">Fases do voo</h3><span class="note" id="ph-note"></span></div>
      <div class="card-b">
        <div class="phases" id="phases"></div>
        <div class="ph-legend">
          <span><i style="background:#7C8F98"></i><span data-i18n="voo.phase.ground">solo</span></span>
          <span><i style="background:#2F7D50"></i><span data-i18n="voo.phase.climb">subida</span></span>
          <span><i style="background:#2C7CA5"></i><span data-i18n="voo.phase.cruise">cruzeiro</span></span>
          <span><i style="background:#B85400"></i><span data-i18n="voo.phase.descent">descida</span></span>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-h"><h3 data-i18n="voo.track.title">Trajetória</h3>
        <div class="layers">
          <button class="lb on" data-layer="turb" data-i18n="voo.turbulence">Turbulência</button>
          <button class="lb" data-layer="wx" data-i18n="voo.weather">Clima</button>
          <button class="lb" data-layer="alt" data-i18n="voo.altitude">Altitude</button>
        </div>
        <span class="note" id="map-note"></span></div>
      <div id="map"></div>
      <div class="legend-line"><span id="legend" style="display:flex;gap:14px"></span><span style="margin-left:auto" id="map-count"></span></div>
    </div>

    <div class="card">
      <div class="card-h"><h3 data-i18n="voo.debrief.title">Debrief</h3><span class="note" data-i18n="voo.hover.note">passe o cursor · o ponto acompanha no mapa</span></div>
      <div class="card-b">
        <div class="readout" id="readout"></div>
        <div id="charts"></div>
      </div>
    </div>

    <div class="card">
      <div class="card-h"><h3 data-i18n="voo.report.title">Relatório de missão</h3></div>
      <div class="card-b report-b">
        <div class="obs-block">
          <span class="obs-tag" data-i18n="voo.report.autosummary">Resumo automático · gerado da telemetria</span>
          <div id="obs"></div>
        </div>
        <div class="obs-block">
          <div class="obs-block-head">
            <span class="obs-tag" data-i18n="voo.report.pilotreport">Relato do piloto</span>
            <button class="btn btn-sm" id="report-edit" data-i18n="voo.report.edit">Editar</button>
          </div>
          <div class="report-view" id="report-view">
            <p class="obs" id="report-view-text"></p>
          </div>
          <div class="report-edit-wrap" id="report-edit-wrap" style="display:none">
            <textarea id="pilot-obs" class="report-ta" placeholder="O que o sensor não mede: por que desviou, como foi a decisão em voo, o que valeu registrar sobre essa missão…" data-i18n-attr="placeholder:voo.report.placeholder"></textarea>
            <div class="report-foot">
              <span class="report-error" id="report-error" style="display:none"></span>
              <span class="report-count" id="report-count">0 caracteres</span>
              <button class="btn" id="report-cancel" data-i18n="common.cancel">Cancelar</button>
              <button class="btn btn-primary" id="report-save" data-i18n="voo.report.save">Salvar relato</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-h"><h3 data-i18n="voo.photos.title">Fotos do voo</h3><span class="note" id="photos-count"></span></div>
      <div class="card-b">
        <p class="obs" id="photos-empty" data-i18n="voo.photos.empty">Nenhuma foto anexada a este voo ainda.</p>
        <div class="photo-grid" id="photo-grid"></div>
        <div class="photo-upload">
          <label class="btn btn-sm" for="photo-input" data-i18n="voo.photos.add">Adicionar fotos</label>
          <input type="file" id="photo-input" accept="image/jpeg,image/png,image/webp" multiple style="display:none">
          <span class="photo-hint" data-i18n="voo.photos.hint">JPEG, PNG ou WEBP · até 8 MB cada · até 12 fotos por voo</span>
        </div>
        <span class="report-error" id="photos-error" style="display:none"></span>
      </div>
    </div>

    <div class="card">
      <div class="card-h"><h3 data-i18n="voo.danger.title">Marcar este voo como acidentado</h3></div>
      <div class="card-b">
        <p class="obs" data-i18n="voo.danger.desc">Voo registrado por engano — acidente no meio do trajeto, sessão corrompida, ou qualquer outro motivo pra essa perna não valer? Marcar como acidentado deixa o voo no Logbook (com um selo, pra histórico) mas tira ele das horas/estatísticas, e devolve a aeronave pra origem dessa perna, como se ela nunca tivesse partido. Só é possível marcar o voo <b>mais recente</b> de cada aeronave — se voos mais novos dela já foram registrados, marque-os primeiro, na ordem inversa. Esta ação não pode ser desfeita.</p>
        <span class="report-error" id="delete-error" style="display:none"></span>
        <p class="obs" id="delete-already" style="display:none" data-i18n="voo.danger.already">Este voo já está marcado como acidentado.</p>
        <button class="btn btn-danger" id="delete-flight" type="button" data-armed="0" data-i18n="voo.danger.button">Marcar como acidentado</button>
      </div>
    </div>

    <div class="card">
      <div class="card-h"><h3 data-i18n="voo.purge.title">Excluir este voo permanentemente</h3></div>
      <div class="card-b">
        <p class="obs" data-i18n="voo.purge.desc">Diferente de marcar como acidentado, isto apaga o voo de vez — telemetria inteira incluída, sem deixar rastro no Logbook. Use pra gravação de teste, duplicata ou qualquer voo que simplesmente não devia existir, marcado como acidentado ou não. Mesma regra: só é possível excluir o voo <b>mais recente</b> de cada aeronave. Esta ação não pode ser desfeita.</p>
        <span class="report-error" id="purge-error" style="display:none"></span>
        <button class="btn btn-danger" id="purge-flight" type="button" data-armed="0" data-i18n="voo.purge.button">Excluir permanentemente</button>
      </div>
    </div>
  </div>

  <div>
    <div class="card">
      <div class="card-h"><h3 data-i18n="voo.landing.title">Pouso</h3><span class="note" id="land-note"></span></div>
      <div class="card-b" id="land"></div>
    </div>

    <div class="card">
      <div class="card-h"><h3 data-i18n="voo.parcels.title">Composição do índice</h3></div>
      <div class="card-b" id="parcels"></div>
    </div>

    <div class="card">
      <div class="card-h"><h3 data-i18n="voo.events.title">Registro de eventos</h3><span class="note" id="ev-count"></span></div>
      <div class="card-b" id="events"></div>
    </div>

    <div class="card">
      <div class="card-h"><h3 data-i18n="voo.links.title">Referências externas</h3></div>
      <div class="card-b links">
        <div class="link-row" id="simbrief-row">
          <a class="link-view" id="simbrief-view" href="#" target="_blank" rel="noopener" style="display:none">
            <span class="ic">SB</span><span><b>SimBrief</b><br><span style="font-size:12px" data-i18n="voo.links.simbrief">Plano de voo · OFP</span></span><span class="ext">↗</span>
          </a>
          <div class="link-empty" id="simbrief-empty">
            <span class="ic">SB</span><span><b>SimBrief</b><br><span style="font-size:12px" data-i18n="voo.links.simbrief.empty">Nenhum link salvo pra este voo</span></span>
            <button type="button" class="btn btn-sm" id="simbrief-add" data-i18n="voo.links.simbrief.add">Adicionar</button>
          </div>
          <button type="button" class="link-edit-btn" id="simbrief-edit" style="display:none" data-i18n-attr="title:voo.links.simbrief.edit" title="Editar">✎</button>
        </div>
        <div class="link-edit-wrap" id="simbrief-edit-wrap" style="display:none">
          <input type="url" id="simbrief-input" placeholder="https://www.simbrief.com/…" data-i18n-attr="placeholder:voo.links.simbrief.placeholder">
          <button type="button" class="btn btn-sm btn-primary" id="simbrief-save" data-i18n="voo.links.simbrief.save">Salvar</button>
          <button type="button" class="btn btn-sm" id="simbrief-cancel" data-i18n="common.cancel">Cancelar</button>
          <span class="report-error" id="simbrief-error" style="display:none"></span>
        </div>

        {% if pilot.aviodeckUsername %}
        <a href="https://aviodeck.app/@{{ pilot.aviodeckUsername }}" target="_blank" rel="noopener"><span class="ic">AD</span><span><b>AvioDeck</b><br><span style="font-size:12px" data-i18n="voo.links.aviodeck">Perfil do piloto</span></span><span class="ext">↗</span></a>
        {% else %}
        <a href="{{ path('app_perfil') }}"><span class="ic">AD</span><span><b>AvioDeck</b><br><span style="font-size:12px" data-i18n="voo.links.aviodeck.empty">Configure seu usuário no perfil</span></span><span class="ext">＋</span></a>
        {% endif %}

        <a href="https://stats.vatsim.net/stats/{{ pilot.cid }}" target="_blank" rel="noopener"><span class="ic">VS</span><span><b>VATSIM</b><br><span style="font-size:12px" data-i18n="voo.links.vatsim">Estatísticas · CID {{ pilot.cid }}</span></span><span class="ext">↗</span></a>
        <a href="#" id="csv-link"><span class="ic">↓</span><span><b>Telemetria</b><br><span style="font-size:12px" data-i18n="voo.links.csv">CSV bruto</span></span><span class="ext">CSV</span></a>
        <a href="#" id="gpx-link"><span class="ic">↓</span><span><b>Traço GPX</b><br><span style="font-size:12px" data-i18n="voo.links.gpx">Baixar arquivo GPX</span></span><span class="ext">GPX</span></a>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block page_javascripts %}
<script>
  window.KATABATIC_FLIGHTS_URL = {{ flightsUrl|json_encode|raw }};
</script>
