{% extends 'base.html.twig' %}

{% block title %}Katabatic — Companhia aérea virtual de operação extrema{% endblock %}
{% block meta_description %}Companhia aérea virtual de carga e pesquisa em área extrema. Alasca e Patagônia, no MSFS 2024 e na rede VATSIM.{% endblock %}

{% block map_assets %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" defer></script>
{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="/assets/css/pages/home.css">
{% endblock %}

{% block body %}

<header class="topbar">
  <div class="wrap topbar-inner">
    <a class="brand" href="{{ path('app_home') }}">
      {% include 'partials/_brand.html.twig' %}
    </a>
    <nav class="topnav">
      <a href="#empresa" data-i18n="nav.company">A empresa</a>
      <a href="#mapa" data-i18n="nav.map">Mapa</a>
      <a href="#bases" data-i18n="nav.bases">Bases</a>
      <a href="#frota" data-i18n="nav.fleet">Frota</a>
      <a href="#voos" data-i18n="nav.ops">Operações</a>
    </nav>
    <div class="tools">
      <div class="lang" role="group" aria-label="Idioma" data-i18n-attr="aria-label:a11y.language">
        <button type="button" data-lang="pt" aria-pressed="true">PT</button>
        <button type="button" data-lang="en" aria-pressed="false">EN</button>
      </div>
      <button class="theme-toggle" id="theme" aria-label="Alternar tema" data-i18n-attr="aria-label:a11y.theme">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <a class="btn" href="{{ path('app_login') }}" data-i18n="nav.pilot">Área do piloto</a>
    </div>
  </div>
</header>

<section class="hero">
  <div class="hero-media" aria-hidden="true">
    <img src="/assets/img/home/hero.jpg" alt="">
  </div>
  <div class="hero-scrim"></div>
  <div class="wrap hero-inner">
    <span class="badge" data-i18n="hero.badge">Companhia aérea virtual · MSFS 2024 · VATSIM</span>
    <h1>Katabatic</h1>
    <p class="hero-lead" data-i18n="hero.lead">Operamos carga e passageiros entre pistas de cascalho, gelo e vento — do interior do Alasca ao Himalaia, passando pelos Andes, a Patagônia e as terras altas da Papua. E voamos para dentro das tempestades que todo mundo desvia.</p>
    <div class="hero-cta">
      <a class="btn btn-primary btn-lg" href="#empresa" data-i18n="hero.cta1">Conheça a operação</a>
      <a class="btn btn-ghost btn-lg" href="#tripulacao" data-i18n="hero.cta2">Voar conosco</a>
    </div>
  </div>
</section>

<div class="board">
  <div class="wrap board-grid">
    {% for cell in board %}
    <div class="board-cell">
      <div class="board-top">
        <span class="board-icao">{{ cell.icao }}</span>
        <span class="board-name" data-i18n="{{ cell.nameKey }}">{{ cell.nameFallback }}</span>
        <span class="board-time">{{ cell.time }}</span>
      </div>
      {% if cell.metar %}
      <div class="board-metar{% if cell.metarGusty %} warn{% endif %}" data-i18n-attr="title:board.metarHint" title="METAR mais recente">{{ cell.metar }}</div>
      {% else %}
      <div class="board-metar board-metar-empty" data-i18n="board.metarUnavailable">METAR indisponível</div>
      {% endif %}
    </div>
    {% endfor %}
  </div>
</div>

<section class="section" id="mapa">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow" data-i18n="map.eyebrow">Rede</p>
      <h2 class="h2" data-i18n="map.title">Onde estamos agora</h2>
      <p data-i18n="map.lead">Seis bases espalhadas pelo planeta. As aeronaves aparecem aqui enquanto o ACARS transmite.</p>
    </div>

    <div class="map-wrap">
      <div class="map-bar">
        <div class="map-tabs">
          <select id="map-pane" class="map-pane-select">
            <option value="pafa">KBT PAFA · Fairbanks</option>
            <option value="scci">KBT SCCI · Punta Arenas</option>
            <option value="sllp">KBT SLLP · La Paz</option>
            <option value="vnkt">KBT VNKT · Catmandu</option>
            <option value="wajw">KBT WAJW · Wamena</option>
            <option value="vqpr">KBT VQPR · Paro</option>
          </select>
          <button type="button" id="radar-btn" aria-pressed="false" data-i18n="map.radar">Radar</button>
          <button type="button" id="owm-btn" aria-pressed="false" data-i18n="map.model">Modelo</button>
        </div>
        <span class="map-live"><i></i><span id="map-live-count">···</span></span>
      </div>

      <div class="map-canvas" id="map"></div>

      <div class="legend" aria-hidden="true">
        <h4 data-i18n="lg.net">Malha</h4>
        <ul>
          <li><i style="background:#FF8A1F"></i><span data-i18n="lg.base">Base</span></li>
          <li><i style="background:#8FA3AD"></i><span data-i18n="lg.stn">Estação avançada</span></li>
        </ul>
        <h4 data-i18n="lg.wx">Condição no destino</h4>
        <ul>
          <li><i style="background:#8FA3AD"></i><span data-i18n="lg.calm">Calmo</span></li>
          <li><i style="background:#FF8A1F"></i><span data-i18n="lg.gust">Rajada</span></li>
          <li><i style="background:#5AA9D6"></i><span data-i18n="lg.ice">Gelo</span></li>
          <li><i style="background:#A78BFA"></i><span data-i18n="lg.fog">Neblina</span></li>
          <li><i style="background:#E4574A"></i><span data-i18n="lg.storm">Tempestade</span></li>
        </ul>
      </div>

      <div class="map-foot">
        <span id="map-foot-flight"></span>
        <span id="radar-stamp"></span>
      </div>
    </div>
  </div>
</section>

<section class="section section-alt" id="empresa">
  <div class="wrap about">
    <div class="about-body">
      <p class="eyebrow" data-i18n="about.eyebrow">A empresa</p>
      <h2 class="h2" data-i18n="about.title">Fundada para ir onde a linha aérea não vai</h2>
      <p data-i18n="about.p1">A Katabatic nasceu em 2026 de uma ideia simples: <strong>quase toda companhia virtual voa entre capitais.</strong> Nós fazemos o contrário — pista curta, cascalho, neve compactada, vento de encosta e teto baixo.</p>
      <p data-i18n="about.p2">Operamos seis bases nos extremos do planeta — do interior do Alasca ao Himalaia, passando pelos Andes, a Patagônia e as terras altas da Papua. PAFA e SCCI, as duas originais, ainda se revezam com o inverno de cada hemisfério e reposicionam parte da frota entre elas; as quatro mais novas operam o ano inteiro na própria estação difícil, sem pausa pra trocar de hemisfério.</p>
      <p data-i18n="about.p3">Além do transporte, mantemos uma linha de <strong>voos de pesquisa meteorológica</strong>: pernas planejadas para atravessar sistemas convectivos com instrumentação registrando o que a aeronave sofreu — turbulência, gelo, rajada e visibilidade, segundo a segundo.</p>
      <div class="note">
        <b data-i18n="about.noteTitle">Para quem está chegando agora</b>
        <p data-i18n="about.noteBody">A Katabatic é uma companhia aérea virtual. Não transportamos carga ou pessoas de verdade: todos os voos acontecem no Microsoft Flight Simulator 2024, com controle de tráfego aéreo feito por pessoas na rede VATSIM. As rotas, o clima e as aeronaves são reais — a operação é simulada.</p>
      </div>
      <div class="figures">
        {% for figure in figures %}
        <div class="figure"><b class="num">{{ figure.value }}</b><span data-i18n="{{ figure.labelKey }}">{{ figure.labelFallback }}</span></div>
        {% endfor %}
      </div>
    </div>
    <figure class="shot">
      <div class="shot-frame r-tall">
        <img src="/assets/img/home/cabine.jpg" alt="Cabine do KBT412 em cruzeiro, sobrevoando um campo de gelo sob céu fechado — legenda já embutida na foto">
      </div>
    </figure>
  </div>
</section>

<section class="section" id="bases">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow" data-i18n="bases.eyebrow">Bases</p>
      <h2 class="h2" data-i18n="bases.title">Seis bases nos extremos do planeta</h2>
      <p data-i18n="bases.lead">Cada base tem sua frota registrada localmente, seu tipo de missão e sua estação difícil — algumas trocam de hemisfério a cada temporada, outras operam o ano inteiro na própria dificuldade.</p>
    </div>

    {% for base in bases %}
    {# DOM sempre na mesma ordem (texto, depois foto) - a inversão visual
       nas linhas ímpares é só CSS (`.base-rev .base-text{order:2}`, ver
       home.css), que também já reseta pra ordem de leitura normal no
       mobile (`order:0` dentro do media query) - inverter o DOM aqui
       quebraria esse reset e faria linhas ímpares lerem foto-antes-do-
       texto no celular. #}
    <article class="base{% if loop.index0 is odd %} base-rev{% endif %}">
      <div class="base-text">
        <span class="base-tag" data-i18n="{{ base.tagKey }}">{{ base.tagFallback }}</span>
        <h3 data-i18n="{{ base.titleKey }}">{{ base.titleFallback }}</h3>
        <p data-i18n="{{ base.bodyKey }}">{{ base.bodyFallback }}</p>
        <ul class="base-list">
          <li><span data-i18n="bases.field">Aeródromo</span><b>{{ base.field }}</b></li>
          <li><span data-i18n="bases.dest">Destinos regulares</span><b>{{ base.destinations }}</b></li>
          <li><span data-i18n="bases.leg">Perna média</span><b>{{ base.avgLeg }}</b></li>
          <li><span data-i18n="bases.based">Aeronaves baseadas</span><b>{{ base.basedAircraft }}</b></li>
        </ul>
        <div class="stations">
          <span class="stations-label" data-i18n="bases.stations">Estações avançadas</span>
          <div class="chips">
            {% for station in base.stations %}
            <span class="chip">{{ station.icao }} <em>{{ station.name }}</em></span>
            {% endfor %}
          </div>
        </div>
      </div>
      <figure class="shot">
        {% if base.photo %}
        <div class="shot-frame r-wide">
          <img src="{{ base.photo }}" alt="{{ base.photoAlt }}">
        </div>
        {% if base.capKey %}<figcaption data-i18n="{{ base.capKey }}">{{ base.capFallback }}</figcaption>{% endif %}
        {% else %}
        <div class="shot-frame r-wide" data-hint="{{ base.icao }} · sem foto ainda"></div>
        {% endif %}
      </figure>
    </article>
    {% endfor %}
  </div>
</section>

<section class="section section-alt" id="frota">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow" data-i18n="fleet.eyebrow">Frota</p>
      <h2 class="h2" data-i18n="fleet.title">Uma frota, seis bandeiras</h2>
      <p data-i18n="fleet.lead">Os tipos que voamos de verdade — um registro de matrícula por base (N americano, CC chileno, CP boliviano, 9N nepalês, PK indonésio, A5 butanês), mas todo mundo turboélice e capaz de sair de pista curta e não pavimentada.</p>
    </div>
    <ul class="fleet-list">
      {% for t in fleet %}
      <li>
        <span class="fleet-type-name">{{ t.tipo }}</span>
        <span class="fleet-type-meta">
          <span>{{ t.count }} {{ t.count == 1 ? 'aeronave' : 'aeronaves' }}</span>
          <span>{{ t.bases|join(', ') }}</span>
          <span>{{ t.horas }} h</span>
        </span>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="section" id="voos">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow" data-i18n="ops.eyebrow">Operações recentes</p>
      <h2 class="h2" data-i18n="ops.title">Todo voo vira relatório</h2>
      <p data-i18n="ops.lead">Posição, atitude, forças e condições registradas a cada segundo pelo nosso ACARS. O índice de dificuldade à direita sai da telemetria — não da opinião de quem voou.</p>
    </div>
    <div class="flights">
      {% for flight in recentFlights %}
      <a class="flight" href="#">
        <div><div class="flight-call">{{ flight.call }}</div><div class="flight-sub" data-i18n="{{ flight.tagKey }}">{{ flight.tagFallback }}</div></div>
        <div><div class="flight-route">{{ flight.from }} <i></i> {{ flight.to }}</div><div class="flight-sub">{{ flight.fromToLabel }}</div></div>
        <div class="flight-meta">{{ flight.reg }} · {{ flight.type }}<br>{{ flight.date }} · {{ flight.duration }}</div>
        <div class="flight-diff lvl-{{ flight.level }}"><div class="diff-bar"><i style="width:{{ flight.diff }}%"></i></div><div class="diff-val">{{ flight.diff }}</div></div>
      </a>
      {% else %}
      <p class="empty-note" data-i18n="ops.empty">Nenhum voo com telemetria gravada ainda — assim que o primeiro ACARS fechar, ele aparece aqui.</p>
      {% endfor %}
    </div>
    <div class="more"><a class="btn" href="{{ path('app_portal') }}" data-i18n="ops.more">Ver o registro completo</a></div>
  </div>
</section>

<section class="section section-alt" id="tripulacao">
  <div class="wrap crew">
    <div>
      <p class="eyebrow" data-i18n="crew.eyebrow">Tripulação</p>
      <h2 class="h2" data-i18n="crew.title">Entrada por avaliação</h2>
      <p style="color:var(--text-2)" data-i18n="crew.lead">A Katabatic não abre vagas em massa. São três voos de avaliação com callsign próprio, julgados pelos mesmos dados que geram os relatórios públicos — ninguém é aprovado no olho, e ninguém é reprovado por opinião.</p>
      <div class="hero-cta">
        <a class="btn btn-primary btn-lg" href="{{ path('app_adesao') }}" data-i18n="crew.cta1">Iniciar avaliação</a>
        <a class="btn btn-lg" href="#" data-i18n="crew.cta2">Manual de operações</a>
      </div>
      <figure class="shot" style="margin-top:36px">
        <div class="shot-frame r-wide">
          <img src="/assets/img/home/tripulacao.jpg" alt="Dois KBT em formação ao pôr do sol, sobre a costa patagônica — legenda já embutida na foto">
        </div>
      </figure>
    </div>
    <ul class="criteria">
      {% for criterion in crewCriteria %}
      <li><b>{{ criterion.num }}</b><span data-i18n="{{ criterion.key }}">{{ criterion.fallback|raw }}</span></li>
      {% endfor %}
    </ul>
  </div>
</section>

<footer class="foot">
  <div class="wrap">
    <div class="foot-top">
      <a class="brand" href="{{ path('app_home') }}">
        {% include 'partials/_brand.html.twig' %}
      </a>
      <nav class="foot-links">
        <a href="#empresa" data-i18n="nav.company">A empresa</a>
        <a href="#frota" data-i18n="nav.fleet">Frota</a>
        <a href="#voos" data-i18n="nav.ops">Operações</a>
        <a href="#" data-i18n="foot.contact">Contato</a>
        <a href="#" data-i18n="foot.privacy">Privacidade</a>
      </nav>
    </div>
    <p class="disclaimer" data-i18n="foot.disclaimer">Katabatic é uma companhia aérea virtual, operada como hobby no Microsoft Flight Simulator 2024 e na rede VATSIM. Não é uma empresa aérea real, não vende passagens e não transporta carga ou passageiros. Aeródromos, matrículas e rotas são usados apenas em contexto de simulação.</p>
  </div>
</footer>

{% endblock %}

{% block javascripts %}
<script>
  window.KATABATIC_HOME_POSICOES_URL = {{ posicoesUrl|json_encode|raw }};
  window.KATABATIC_CARTO_API_KEY = {{ cartoApiKey|json_encode|raw }};
</script>
<script src="/assets/js/pages/home.js" defer></script>
{% endblock %}
