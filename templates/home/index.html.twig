{% extends 'base.html.twig' %}

{% block title %}Katabatic — Companhia aérea virtual de operação extrema{% endblock %}
{% block meta_description %}Companhia aérea virtual de carga e pesquisa em área extrema. Alasca e Patagônia, no MSFS 2024 e na rede VATSIM.{% endblock %}

{% block map_assets %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" defer></script>
{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="/assets/css/pages/home.css">
{% endblock %}

{% block body %}

<header class="topbar">
  <div class="wrap topbar-inner">
    <a class="brand" href="{{ path('app_home') }}">
      {% include 'partials/_brand.html.twig' %}
    </a>
    <nav class="topnav">
      <a href="#empresa" data-i18n="nav.company">A empresa</a>
      <a href="#mapa" data-i18n="nav.map">Mapa</a>
      <a href="#bases" data-i18n="nav.bases">Bases</a>
      <a href="#frota" data-i18n="nav.fleet">Frota</a>
      <a href="#voos" data-i18n="nav.ops">Operações</a>
    </nav>
    <div class="tools">
      <div class="lang" role="group" aria-label="Idioma">
        <button type="button" data-lang="pt" aria-pressed="true">PT</button>
        <button type="button" data-lang="en" aria-pressed="false">EN</button>
      </div>
      <button class="theme-toggle" id="theme" aria-label="Alternar tema">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <a class="btn" href="{{ path('app_login') }}" data-i18n="nav.pilot">Área do piloto</a>
    </div>
  </div>
</header>

<section class="hero">
  <div class="hero-media" aria-hidden="true">
    <svg viewBox="0 0 1440 620" preserveAspectRatio="xMidYMid slice">
      <rect width="1440" height="620" fill="#0B1216"/>
      <g fill="none" stroke="#1E3038" stroke-width="1.2">
        <path d="M-40 300 C 180 250, 340 340, 560 300 S 980 220, 1200 286 S 1400 320, 1480 300"/>
        <path d="M-40 350 C 170 300, 350 392, 570 350 S 980 268, 1210 336 S 1400 370, 1480 350"/>
        <path d="M-40 404 C 190 356, 330 446, 580 404 S 980 322, 1200 390 S 1400 424, 1480 404"/>
        <path d="M-40 462 C 200 414, 340 504, 590 462 S 990 380, 1210 448 S 1400 482, 1480 462"/>
        <path d="M-40 524 C 210 476, 350 566, 600 524 S 1000 442, 1220 510 S 1400 544, 1480 524"/>
      </g>
      <path d="M-40 300 C 180 250, 340 340, 560 300 S 980 220, 1200 286 S 1400 320, 1480 300 L1480 620 L-40 620 Z" fill="#0D171C"/>
    </svg>
  </div>
  <div class="hero-scrim"></div>
  <div class="wrap hero-inner">
    <span class="badge" data-i18n="hero.badge">Companhia aérea virtual · MSFS 2024 · VATSIM</span>
    <h1>Katabatic</h1>
    <p class="hero-lead" data-i18n="hero.lead">Operamos carga e passageiros entre pistas de cascalho, gelo e vento — do interior do Alasca à Patagônia austral. E voamos para dentro das tempestades que todo mundo desvia.</p>
    <div class="hero-cta">
      <a class="btn btn-primary btn-lg" href="#empresa" data-i18n="hero.cta1">Conheça a operação</a>
      <a class="btn btn-ghost btn-lg" href="#tripulacao" data-i18n="hero.cta2">Voar conosco</a>
    </div>
  </div>
  <span class="hero-shot-note" data-i18n="hero.shot">Trocar por captura do simulador — 2560×1100</span>
</section>

<div class="board">
  <div class="wrap board-grid">
    {% for cell in board %}
    <div class="board-cell">
      <div class="board-top">
        <span class="board-icao">{{ cell.icao }}</span>
        <span class="board-name" data-i18n="{{ cell.nameKey }}">{{ cell.nameFallback }}</span>
        <span class="board-time">{{ cell.time }}</span>
      </div>
      <div class="board-metrics">
        <div><span data-i18n="board.wind">Vento</span><b{% if cell.windWarn %} class="warn"{% endif %}>{{ cell.wind }}</b></div>
        <div><span data-i18n="board.temp">Temp</span><b>{{ cell.temp }}</b></div>
        <div><span data-i18n="board.vis">Visib.</span><b{% if cell.visWarn %} class="warn"{% endif %}>{{ cell.vis }}</b></div>
        <div><span data-i18n="board.ceil">Teto</span><b>{{ cell.ceil }}</b></div>
      </div>
    </div>
    {% endfor %}
  </div>
</div>

<section class="section" id="mapa">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow" data-i18n="map.eyebrow">Rede</p>
      <h2 class="h2" data-i18n="map.title">Onde estamos agora</h2>
      <p data-i18n="map.lead">Duas malhas independentes, a 13 000 km uma da outra. As aeronaves aparecem aqui enquanto o ACARS transmite.</p>
    </div>

    <div class="map-wrap">
      <div class="map-bar">
        <div class="map-tabs">
          <button type="button" data-pane="north" aria-pressed="true">KBT Norte</button>
          <button type="button" data-pane="south" aria-pressed="false">KBT Sul</button>
          <button type="button" id="radar-btn" aria-pressed="false" data-i18n="map.radar">Radar</button>
          <button type="button" id="owm-btn" aria-pressed="false" data-i18n="map.model">Modelo</button>
        </div>
        <span class="map-live"><i></i><span data-i18n="map.live">2 em voo</span></span>
      </div>

      <div class="map-canvas" id="map"></div>

      <div class="legend" aria-hidden="true">
        <h4 data-i18n="lg.net">Malha</h4>
        <ul>
          <li><i style="background:#FF8A1F"></i><span data-i18n="lg.base">Base</span></li>
          <li><i style="background:#8FA3AD"></i><span data-i18n="lg.stn">Estação avançada</span></li>
        </ul>
        <h4 data-i18n="lg.wx">Condição no destino</h4>
        <ul>
          <li><i style="background:#8FA3AD"></i><span data-i18n="lg.calm">Calmo</span></li>
          <li><i style="background:#FF8A1F"></i><span data-i18n="lg.gust">Rajada</span></li>
          <li><i style="background:#5AA9D6"></i><span data-i18n="lg.ice">Gelo</span></li>
          <li><i style="background:#A78BFA"></i><span data-i18n="lg.fog">Neblina</span></li>
          <li><i style="background:#E4574A"></i><span data-i18n="lg.storm">Tempestade</span></li>
        </ul>
      </div>

      <div class="map-foot">
        <span><b>KBT118</b> PAFA &rarr; PABT · 42 min</span>
        <span><b>KBT412</b> SCCI &rarr; SCNT · 18 min</span>
        <span id="radar-stamp"></span>
      </div>
    </div>
    <p class="map-note" data-i18n="map.note">Mapa base OpenStreetMap via CARTO. Radar (RainViewer) depende de estações em solo — funciona bem no Alasca, quase não existe na Patagônia. Modelo (OpenWeather) cobre o globo inteiro, inclusive onde não há radar. O histórico detalhado por voo vem de um pipeline próprio.</p>
  </div>
</section>

<section class="section section-alt" id="empresa">
  <div class="wrap about">
    <div class="about-body">
      <p class="eyebrow" data-i18n="about.eyebrow">A empresa</p>
      <h2 class="h2" data-i18n="about.title">Fundada para ir onde a linha aérea não vai</h2>
      <p data-i18n="about.p1">A Katabatic nasceu em 2026 de uma ideia simples: <strong>quase toda companhia virtual voa entre capitais.</strong> Nós fazemos o contrário — pista curta, cascalho, neve compactada, vento de encosta e teto baixo.</p>
      <p data-i18n="about.p2">Operamos duas frentes em hemisférios opostos. Quando o inverno aperta no Alasca, a temporada dura começa na Patagônia, e a frota se reposiciona. A empresa nunca sai da estação difícil.</p>
      <p data-i18n="about.p3">Além do transporte, mantemos uma linha de <strong>voos de pesquisa meteorológica</strong>: pernas planejadas para atravessar sistemas convectivos com instrumentação registrando o que a aeronave sofreu — turbulência, gelo, rajada e visibilidade, segundo a segundo.</p>
      <div class="note">
        <b data-i18n="about.noteTitle">Para quem está chegando agora</b>
        <p data-i18n="about.noteBody">A Katabatic é uma companhia aérea virtual. Não transportamos carga ou pessoas de verdade: todos os voos acontecem no Microsoft Flight Simulator 2024, com controle de tráfego aéreo feito por pessoas na rede VATSIM. As rotas, o clima e as aeronaves são reais — a operação é simulada.</p>
      </div>
      <div class="figures">
        {% for figure in figures %}
        <div class="figure"><b class="num">{{ figure.value }}</b><span data-i18n="{{ figure.labelKey }}">{{ figure.labelFallback }}</span></div>
        {% endfor %}
      </div>
    </div>
    <figure class="shot">
      <div class="shot-frame r-tall" data-hint="Cabine em cruzeiro, tempo fechado · 4:5">
        <svg viewBox="0 0 400 500" preserveAspectRatio="none" aria-hidden="true">
          <g fill="none" stroke="#1E3038" stroke-width="1">
            <path d="M-10 340 C 90 310, 170 366, 260 336 S 380 300, 420 330"/>
            <path d="M-10 386 C 100 356, 180 412, 268 382 S 380 346, 420 376"/>
            <path d="M-10 432 C 110 402, 190 458, 276 428 S 380 392, 420 422"/>
          </g>
        </svg>
      </div>
      <figcaption data-i18n="cap.cockpit">Sua captura aqui · KBT412 sobre o campo de gelo</figcaption>
    </figure>
  </div>
</section>

<section class="section" id="bases">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow" data-i18n="bases.eyebrow">Bases</p>
      <h2 class="h2" data-i18n="bases.title">Duas pontas do continente</h2>
      <p data-i18n="bases.lead">Cada base tem sua frota registrada localmente, seu tipo de missão e sua estação difícil. Entre elas, 13 000 km e um voo de reposicionamento por temporada.</p>
    </div>

    <article class="base">
      <div class="base-text">
        <span class="base-tag" data-i18n="bases.north.tag">KBT Norte · matrícula N</span>
        <h3 data-i18n="bases.north.title">Fairbanks — interior e Ártico</h3>
        <p data-i18n="bases.north.body">Porta de entrada do Ártico. Daqui saem os voos de suprimento para campos sem estrada e as pernas de pesquisa acima do Círculo Polar. O interior soma o que a costa não tem: passes de montanha, aproximação em vale e frio que degrada desempenho antes de qualquer outra coisa.</p>
        <ul class="base-list">
          <li><span data-i18n="bases.field">Aeródromo</span><b>{{ bases.north.field }}</b></li>
          <li><span data-i18n="bases.dest">Destinos regulares</span><b>{{ bases.north.destinations }}</b></li>
          <li><span data-i18n="bases.leg">Perna média</span><b>{{ bases.north.avgLeg }}</b></li>
          <li><span data-i18n="bases.based">Aeronaves baseadas</span><b>{{ bases.north.basedAircraft }}</b></li>
        </ul>
        <div class="stations">
          <span class="stations-label" data-i18n="bases.stations">Estações avançadas</span>
          <div class="chips">
            {% for station in bases.north.stations %}
            <span class="chip">{{ station.icao }} <em>{{ station.name }}</em></span>
            {% endfor %}
          </div>
        </div>
      </div>
      <figure class="shot">
        <div class="shot-frame r-wide" data-hint="Caravan em pista de cascalho no interior do Alasca · 16:9">
          <svg viewBox="0 0 640 360" preserveAspectRatio="none" aria-hidden="true">
            <g fill="none" stroke="#1E3038" stroke-width="1">
              <path d="M-10 210 C 120 180, 220 236, 340 206 S 560 170, 660 200"/>
              <path d="M-10 256 C 130 226, 230 282, 348 252 S 560 216, 660 246"/>
              <path d="M-10 306 C 140 276, 240 332, 356 302 S 560 266, 660 296"/>
            </g>
          </svg>
        </div>
        <figcaption data-i18n="cap.north">Sua captura aqui · N208KB em Bettles</figcaption>
      </figure>
    </article>

    <article class="base base-rev">
      <figure class="shot">
        <div class="shot-frame r-wide" data-hint="Twin Otter sobre fiorde patagônico · 16:9">
          <svg viewBox="0 0 640 360" preserveAspectRatio="none" aria-hidden="true">
            <g fill="none" stroke="#1E3038" stroke-width="1">
              <path d="M-10 150 C 120 120, 220 176, 340 146 S 560 110, 660 140"/>
              <path d="M-10 202 C 130 172, 230 228, 348 198 S 560 162, 660 192"/>
              <path d="M-10 260 C 140 230, 240 286, 356 256 S 560 220, 660 250"/>
            </g>
          </svg>
        </div>
        <figcaption data-i18n="cap.south">Sua captura aqui · CC-KBA em final para SCNT</figcaption>
      </figure>
      <div class="base-text">
        <span class="base-tag" data-i18n="bases.south.tag">KBT Sul · matrícula CC</span>
        <h3 data-i18n="bases.south.title">Punta Arenas — Magalhães e Patagônia</h3>
        <p data-i18n="bases.south.body">Apoio a estações de pesquisa, travessia de fiordes e transporte de pessoal técnico. É aqui que o vento catabático que dá nome à empresa aparece de verdade: rajadas descendo da cordilheira que mudam a aproximação nos últimos 500 pés.</p>
        <ul class="base-list">
          <li><span data-i18n="bases.field">Aeródromo</span><b>{{ bases.south.field }}</b></li>
          <li><span data-i18n="bases.dest">Destinos regulares</span><b>{{ bases.south.destinations }}</b></li>
          <li><span data-i18n="bases.leg">Perna média</span><b>{{ bases.south.avgLeg }}</b></li>
          <li><span data-i18n="bases.based">Aeronaves baseadas</span><b>{{ bases.south.basedAircraft }}</b></li>
        </ul>
        <div class="stations">
          <span class="stations-label" data-i18n="bases.stations">Estações avançadas</span>
          <div class="chips">
            {% for station in bases.south.stations %}
            <span class="chip">{{ station.icao }} <em>{{ station.name }}</em></span>
            {% endfor %}
          </div>
        </div>
      </div>
    </article>
  </div>
</section>

<section class="section section-alt" id="frota">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow" data-i18n="fleet.eyebrow">Frota</p>
      <h2 class="h2" data-i18n="fleet.title">Seis aeronaves, duas bandeiras</h2>
      <p data-i18n="fleet.lead">Registro chileno no sul, norte-americano no norte. Tudo turboélice, tudo capaz de sair de pista curta e não pavimentada.</p>
    </div>
    <div class="fleet">
      {% for plane in fleet %}
      <article class="plane">
        <div class="shot-frame r-square" data-hint="{{ plane.reg }} · 1:1"></div>
        <div class="plane-body">
          <div class="plane-reg">{{ plane.reg }}</div>
          <div class="plane-type">{{ plane.type }}</div>
          <div class="plane-foot"><span>{{ plane.base }}</span><span>{{ plane.hours }} h</span></div>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section" id="voos">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow" data-i18n="ops.eyebrow">Operações recentes</p>
      <h2 class="h2" data-i18n="ops.title">Todo voo vira relatório</h2>
      <p data-i18n="ops.lead">Posição, atitude, forças e condições registradas a cada segundo pelo nosso ACARS. O índice de dificuldade à direita sai da telemetria — não da opinião de quem voou.</p>
    </div>
    <div class="flights">
      {% for flight in recentFlights %}
      <a class="flight" href="#">
        <div><div class="flight-call">{{ flight.call }}</div><div class="flight-sub" data-i18n="{{ flight.tagKey }}">{{ flight.tagFallback }}</div></div>
        <div><div class="flight-route">{{ flight.from }} <i></i> {{ flight.to }}</div><div class="flight-sub">{{ flight.fromToLabel }}</div></div>
        <div class="flight-meta">{{ flight.reg }} · {{ flight.type }}<br>{{ flight.date }} · {{ flight.duration }}</div>
        <div class="flight-diff lvl-{{ flight.level }}"><div class="diff-bar"><i style="width:{{ flight.diff }}%"></i></div><div class="diff-val">{{ flight.diff }}</div></div>
      </a>
      {% endfor %}
    </div>
    <div class="more"><a class="btn" href="{{ path('app_portal') }}" data-i18n="ops.more">Ver o registro completo</a></div>
  </div>
</section>

<section class="section section-alt" id="tripulacao">
  <div class="wrap crew">
    <div>
      <p class="eyebrow" data-i18n="crew.eyebrow">Tripulação</p>
      <h2 class="h2" data-i18n="crew.title">Entrada por avaliação</h2>
      <p style="color:var(--text-2)" data-i18n="crew.lead">A Katabatic não abre vagas em massa. São três voos de avaliação com callsign próprio, julgados pelos mesmos dados que geram os relatórios públicos — ninguém é aprovado no olho, e ninguém é reprovado por opinião.</p>
      <div class="hero-cta">
        <a class="btn btn-primary btn-lg" href="{{ path('app_adesao') }}" data-i18n="crew.cta1">Iniciar avaliação</a>
        <a class="btn btn-lg" href="#" data-i18n="crew.cta2">Manual de operações</a>
      </div>
      <figure class="shot" style="margin-top:36px">
        <div class="shot-frame r-wide" data-hint="Formação de dois KBT ao pôr do sol · 16:9"></div>
        <figcaption data-i18n="cap.crew">Sua captura aqui · voo em grupo mensal</figcaption>
      </figure>
    </div>
    <ul class="criteria">
      {% for criterion in crewCriteria %}
      <li><b>{{ criterion.num }}</b><span data-i18n="{{ criterion.key }}">{{ criterion.fallback|raw }}</span></li>
      {% endfor %}
    </ul>
  </div>
</section>

<footer class="foot">
  <div class="wrap">
    <div class="foot-top">
      <a class="brand" href="{{ path('app_home') }}">
        {% include 'partials/_brand.html.twig' %}
      </a>
      <nav class="foot-links">
        <a href="#empresa" data-i18n="nav.company">A empresa</a>
        <a href="#frota" data-i18n="nav.fleet">Frota</a>
        <a href="#voos" data-i18n="nav.ops">Operações</a>
        <a href="#" data-i18n="foot.contact">Contato</a>
        <a href="#" data-i18n="foot.privacy">Privacidade</a>
      </nav>
    </div>
    <p class="disclaimer" data-i18n="foot.disclaimer">Katabatic é uma companhia aérea virtual, operada como hobby no Microsoft Flight Simulator 2024 e na rede VATSIM. Não é uma empresa aérea real, não vende passagens e não transporta carga ou passageiros. Aeródromos, matrículas e rotas são usados apenas em contexto de simulação.</p>
  </div>
</footer>

{% endblock %}

{% block javascripts %}
<script src="/assets/js/pages/home.js" defer></script>
{% endblock %}
