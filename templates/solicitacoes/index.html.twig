{% extends 'app_base.html.twig' %}

{% block title %}Solicitações — Katabatic{% endblock %}

{% block page_stylesheets %}
<link rel="stylesheet" href="/assets/css/pages/solicitacoes.css">
{% endblock %}

{% block bar %}
<div class="bar">
  <h1 id="title">Solicitações</h1>
  <div class="lang" role="group" aria-label="Idioma" data-i18n-attr="aria-label:a11y.language">
    <button type="button" data-lang="pt" aria-pressed="true">PT</button>
    <button type="button" data-lang="en" aria-pressed="false">EN</button>
  </div>
  <button class="icon-btn" id="theme" aria-label="Alternar tema" data-i18n-attr="aria-label:a11y.theme">
    <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  </button>
</div>
{% endblock %}

{% block content %}

<div class="action-banner" id="action-banner" style="display:none">
  <span id="action-banner-text"></span>
  <button type="button" class="action-banner-close" id="action-banner-close" data-i18n-attr="aria-label:flash.close" aria-label="Fechar">×</button>
</div>

<!-- ================= SOLICITAÇÕES ================= -->
<section class="view on" id="v-solicitacoes">
  <div class="summary">
    <div><b class="mono" id="sum-pend">—</b><span data-i18n="solicitacoes.status.pending">Pendentes</span></div>
    <div><b class="mono" id="sum-aprov">—</b><span data-i18n="solicitacoes.status.approved">Aprovados</span></div>
    <div><b class="mono" id="sum-rej">—</b><span data-i18n="solicitacoes.status.rejected">Rejeitados</span></div>
    <div><b class="mono" id="sum-total">—</b><span data-i18n="solicitacoes.summary.total">Total de pedidos</span></div>
  </div>

  <div class="filters">
    <button class="chip on" data-status="Todos" type="button" data-i18n="common.all">Todos</button>
    <button class="chip" data-status="pendente" type="button" data-i18n="solicitacoes.status.pending">Pendentes</button>
    <button class="chip" data-status="aprovado" type="button" data-i18n="solicitacoes.status.approved">Aprovados</button>
    <button class="chip" data-status="rejeitado" type="button" data-i18n="solicitacoes.status.rejected">Rejeitados</button>
    <input id="sol-busca" class="lbsearch" type="text" placeholder="Buscar nome, CID, e-mail ou Discord…" data-i18n-attr="placeholder:solicitacoes.search.placeholder">
    <span class="right" id="sol-count"></span>
  </div>

  <div class="card">
    <div class="table-scroll" id="sol-scroll">
      <table id="sol-table">
        <thead>
          <tr>
            <th data-i18n="common.date">Data</th><th data-i18n="solicitacoes.candidate">Candidato</th><th data-i18n="solicitacoes.basepref">Base pref.</th><th data-i18n="solicitacoes.experience">Experiência</th><th>Status</th><th data-i18n="common.actions">Ações</th>
          </tr>
        </thead>
        <tbody id="sol-body"></tbody>
      </table>
      <div class="empty" id="sol-empty" style="display:none" data-i18n="solicitacoes.empty">Nenhuma solicitação com esses filtros.</div>
    </div>
  </div>

  <p class="hint" data-i18n="solicitacoes.hint">Aprovar cria o piloto de verdade (ou liga o pedido a um piloto já existente com o mesmo CID); rejeitar só marca o pedido. Clique numa linha pra ver a motivação completa.</p>
</section>

<!-- ================= PILOTOS ================= -->
<section class="view" id="v-pilotos">
  <div class="summary">
    <div><b class="mono" id="sum-pilotos">—</b><span data-i18n="solicitacoes.pilots.registered">Pilotos cadastrados</span></div>
    <div><b class="mono" id="sum-ativos">—</b><span data-i18n="solicitacoes.pilots.active">Ativos</span></div>
    <div><b class="mono" id="sum-admins">—</b><span data-i18n="solicitacoes.pilots.admins">Administradores</span></div>
    <div><b class="mono" id="sum-voos">—</b><span data-i18n="solicitacoes.pilots.totalflights">Voos somados</span></div>
  </div>

  <div class="filters">
    <input id="pil-busca" class="lbsearch" type="text" placeholder="Buscar nome ou CID…" data-i18n-attr="placeholder:solicitacoes.pilots.search.placeholder">
    <span class="right" id="pil-count"></span>
  </div>

  <div class="card">
    <div class="table-scroll" id="pil-scroll">
      <table id="pil-table">
        <thead>
          <tr>
            <th data-i18n="solicitacoes.pilot">Piloto</th><th>CID</th><th>Base</th><th data-i18n="solicitacoes.role">Papel</th><th data-i18n="solicitacoes.joined">Adesão</th><th class="num" data-i18n="solicitacoes.flights">Voos</th><th>Status</th>
          </tr>
        </thead>
        <tbody id="pil-body"></tbody>
      </table>
      <div class="empty" id="pil-empty" style="display:none" data-i18n="solicitacoes.pilots.empty">Nenhum piloto com essa busca.</div>
    </div>
  </div>
</section>

{% endblock %}

{% block page_javascripts %}
<script>
  window.KATABATIC_SOLICITACOES = {{ solicitacoes|json_encode|raw }};
  window.KATABATIC_PILOTOS = {{ pilotos|json_encode|raw }};
</script>
{# Dicionario EN especifico desta tela - mesclado no dicionario global
   (nunca reatribuido por cima). Cobre os textos estaticos do template
   (data-i18n/data-i18n-attr acima) e os textos montados dinamicamente por
   solicitacoes.js (helper L(), ver o topo daquele arquivo) - as chaves
   solicitacoes.status.* sao reaproveitadas nos tiles de resumo, nos chips
   de filtro E no badge de status de cada linha da tabela, pra manter a
   MESMA palavra em ingles em todo canto que "Pendente/Aprovado/Rejeitado"
   aparece nesta tela. #}
<script>
  (function () {
    var d = {
      'solicitacoes.status.pending': 'Pending',
      'solicitacoes.status.approved': 'Approved',
      'solicitacoes.status.rejected': 'Rejected',
      'solicitacoes.summary.total': 'Total applications',
      'solicitacoes.search.placeholder': 'Search name, CID, e-mail or Discord…',
      'solicitacoes.candidate': 'Candidate',
      'solicitacoes.basepref': 'Preferred base',
      'solicitacoes.experience': 'Experience',
      'solicitacoes.empty': 'No applications matching these filters.',
      'solicitacoes.hint': 'Approving creates the pilot for real (or links the request to an existing pilot with the same CID); rejecting only marks the request. Click a row to see the full statement of motivation.',
      'solicitacoes.error.generic': 'Something went wrong — try again.',
      'solicitacoes.tempPassword': 'Pilot account created for {name} (CID {cid}). Temporary password: {password} — copy it now, it will not be shown again.',
      'solicitacoes.pilots.registered': 'Registered pilots',
      'solicitacoes.pilots.active': 'Active',
      'solicitacoes.pilots.admins': 'Administrators',
      'solicitacoes.pilots.totalflights': 'Total flights',
      'solicitacoes.pilots.search.placeholder': 'Search name or CID…',
      'solicitacoes.pilots.empty': 'No pilots matching this search.',
      'solicitacoes.pilot': 'Pilot',
      'solicitacoes.role': 'Role',
      'solicitacoes.joined': 'Joined',
      'solicitacoes.flights': 'Flights',
      'solicitacoes.approve': 'Approve',
      'solicitacoes.reject': 'Reject',
      'solicitacoes.rowtitle': 'See full statement of motivation',
      'solicitacoes.field.email': 'E-mail',
      'solicitacoes.field.discord': 'Discord',
      'solicitacoes.field.cid': 'CID',
      'solicitacoes.field.heard': 'How they found us',
      'solicitacoes.field.motivation': 'Motivation',
      'solicitacoes.count.one': ' application',
      'solicitacoes.count.many': ' applications',
      'solicitacoes.pilot.status.active': 'Active',
      'solicitacoes.pilot.status.inactive': 'Inactive',
      'solicitacoes.pilots.count.one': ' pilot',
      'solicitacoes.pilots.count.many': ' pilots'
    };
    for (var k in d) { window.KATABATIC_I18N_EN[k] = d[k]; }
  })();
</script>
<script src="/assets/js/pages/solicitacoes.js" defer></script>
{% endblock %}
