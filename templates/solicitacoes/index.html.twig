{% extends 'app_base.html.twig' %}

{% block title %}Solicitações — Katabatic{% endblock %}

{% block page_stylesheets %}
<link rel="stylesheet" href="/assets/css/pages/solicitacoes.css">
{% endblock %}

{% block bar %}
<div class="bar">
  <h1 id="title">Solicitações</h1>
  <div class="lang" role="group" aria-label="Idioma">
    <button type="button" data-lang="pt" aria-pressed="true">PT</button>
    <button type="button" data-lang="en" aria-pressed="false">EN</button>
  </div>
  <button class="icon-btn" id="theme" aria-label="Alternar tema">
    <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  </button>
</div>
{% endblock %}

{% block content %}

<!-- ================= SOLICITAÇÕES ================= -->
<section class="view on" id="v-solicitacoes">
  <div class="summary">
    <div><b class="mono" id="sum-pend">—</b><span>Pendentes</span></div>
    <div><b class="mono" id="sum-aprov">—</b><span>Aprovados</span></div>
    <div><b class="mono" id="sum-rej">—</b><span>Rejeitados</span></div>
    <div><b class="mono" id="sum-total">—</b><span>Total de pedidos</span></div>
  </div>

  <div class="filters">
    <button class="chip on" data-status="Todos" type="button">Todos</button>
    <button class="chip" data-status="pendente" type="button">Pendentes</button>
    <button class="chip" data-status="aprovado" type="button">Aprovados</button>
    <button class="chip" data-status="rejeitado" type="button">Rejeitados</button>
    <input id="sol-busca" class="lbsearch" type="text" placeholder="Buscar nome, CID, e-mail ou Discord…">
    <span class="right" id="sol-count"></span>
  </div>

  <div class="card">
    <div class="table-scroll" id="sol-scroll">
      <table id="sol-table">
        <thead>
          <tr>
            <th>Data</th><th>Candidato</th><th>Base pref.</th><th>Experiência</th><th>Status</th><th>Ações</th>
          </tr>
        </thead>
        <tbody id="sol-body"></tbody>
      </table>
      <div class="empty" id="sol-empty" style="display:none">Nenhuma solicitação com esses filtros.</div>
    </div>
  </div>

  <p class="hint">Aprovar/rejeitar aqui é simulado nesta sessão do navegador (sem backend ainda) — não persiste depois de recarregar a página. Clique numa linha pra ver a motivação completa.</p>
</section>

<!-- ================= PILOTOS ================= -->
<section class="view" id="v-pilotos">
  <div class="summary">
    <div><b class="mono" id="sum-pilotos">—</b><span>Pilotos cadastrados</span></div>
    <div><b class="mono" id="sum-ativos">—</b><span>Ativos</span></div>
    <div><b class="mono" id="sum-admins">—</b><span>Administradores</span></div>
    <div><b class="mono" id="sum-voos">—</b><span>Voos somados</span></div>
  </div>

  <div class="filters">
    <input id="pil-busca" class="lbsearch" type="text" placeholder="Buscar nome ou CID…">
    <span class="right" id="pil-count"></span>
  </div>

  <div class="card">
    <div class="table-scroll" id="pil-scroll">
      <table id="pil-table">
        <thead>
          <tr>
            <th>Piloto</th><th>CID</th><th>Base</th><th>Papel</th><th>Adesão</th><th class="num">Voos</th><th>Status</th>
          </tr>
        </thead>
        <tbody id="pil-body"></tbody>
      </table>
      <div class="empty" id="pil-empty" style="display:none">Nenhum piloto com essa busca.</div>
    </div>
  </div>
</section>

{% endblock %}

{% block page_javascripts %}
<script>
  window.KATABATIC_SOLICITACOES = {{ solicitacoes|json_encode|raw }};
  window.KATABATIC_PILOTOS = {{ pilotos|json_encode|raw }};
</script>
<script src="/assets/js/pages/solicitacoes.js" defer></script>
{% endblock %}
