{# Base das telas da area logada (Portal, Voo, Novo voo, Nova aeronave):
   rail lateral + barra superior, por cima do layout comum de base.html.twig. #}
{% extends 'base.html.twig' %}

{% block stylesheets %}
<link rel="stylesheet" href="/assets/css/app-shell.css">
{% block page_stylesheets %}{% endblock %}
{% endblock %}

{% block body %}
<div class="app">
  {% include 'partials/_rail.html.twig' %}

  <div class="main">
    {# Cada mensagem de flash precisa de uma chave i18n propria (o
       data-i18n so sabe traduzir o texto que ele mesmo captura no load,
       nao interpreta o conteudo) - por enquanto so existe uma, do Perfil;
       ao adicionar uma nova tela que usa addFlash, mapeie o texto exato
       pra uma chave nova aqui em vez de reusar "flash.perfil.updated". #}
    {% for message in app.flashes('success') %}
    <div class="flash flash-success">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
      <span data-i18n="flash.perfil.updated">{{ message }}</span>
      <button type="button" class="flash-close" data-i18n-attr="aria-label:flash.close" aria-label="Fechar">×</button>
    </div>
    {% endfor %}
    {% block bar %}{% endblock %}
    {% block content %}{% endblock %}
  </div>
</div>
{% endblock %}

{% block javascripts %}
{# Dicionario EN da casca comum (rail + barra + botoes de acao + flash)
   das telas logadas. Cada tela ainda define seu proprio dicionario
   (bloco page_javascripts) pra cobrir titulos/formularios/graficos
   especificos dela - ver lang-toggle.js pra como os dois se combinam
   (chave de pagina sobrescreve chave global se repetida), e o cabecalho
   daquele arquivo pra `data-i18n` (innerHTML) vs `data-i18n-attr`
   (atributos como aria-label/placeholder/title). #}
<script>
  window.KATABATIC_I18N_EN = {
    'flash.perfil.updated': 'Profile updated successfully.',
