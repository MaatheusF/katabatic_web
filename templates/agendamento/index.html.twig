{% extends 'app_base.html.twig' %}

{% block title %}Agendamentos — Katabatic{% endblock %}
{% block meta_description %}Agendar voos futuros por aeronave, com a sequência de pernas encadeadas.{% endblock %}

{% block page_stylesheets %}
<link rel="stylesheet" href="/assets/css/pages/agendamento.css">
{% endblock %}

{% block bar %}
<div class="bar">
  <h1 id="title">Agendamentos</h1>
  <button class="btn btn-primary" id="ag-open-form" style="margin-left:auto" data-i18n="agendamento.newbooking">+ Novo agendamento</button>
  <div class="lang" role="group" aria-label="Idioma" data-i18n-attr="aria-label:a11y.language">
    <button type="button" data-lang="pt" aria-pressed="true">PT</button>
    <button type="button" data-lang="en" aria-pressed="false">EN</button>
  </div>
  <button class="icon-btn" id="theme" aria-label="Alternar tema" data-i18n-attr="aria-label:a11y.theme">
    <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  </button>
</div>
{% endblock %}

{% block content %}
<div class="wrap">

  <div class="summary" id="ag-summary">
    <div><b class="mono" id="sum-total">—</b><span data-i18n="agendamento.summary.legs">Pernas agendadas</span></div>
    <div><b class="mono" id="sum-seq">—</b><span data-i18n="agendamento.summary.sequenced">Aeronaves com sequência</span></div>
    <div><b class="mono" id="sum-next">—</b><span data-i18n="agendamento.summary.next">Próximo voo</span></div>
    <div><b class="mono" id="sum-warn">—</b><span data-i18n="agendamento.summary.warnings">Avisos de posição</span></div>
  </div>

  <!-- ================= FORMULÁRIO (colapsado por padrão) ================= -->
  <div class="card ag-form-card" id="ag-form-panel" hidden>
    <div class="card-h"><h3 id="ag-form-title" data-i18n="agendamento.form.title.new">Novo agendamento</h3><span class="note" data-i18n="agendamento.form.subtitle">reserva uma aeronave pra um voo futuro</span></div>
    <div class="card-b">
      <div class="grid2">
        <div class="field">
          <label data-i18n="common.aircraft">Aeronave</label>
          <select id="f-reg">
            <option value="">Selecione…</option>
          </select>
        </div>
        <div class="field">
          <label data-i18n="agendamento.optype.label">Tipo de operação</label>
          <div class="chips" id="f-tipo-chips">
            <button class="chip on" data-tipo="Carga" type="button" data-i18n="common.optype.cargo">Carga</button>
            <button class="chip" data-tipo="Pessoal" type="button" data-i18n="common.optype.personal">Pessoal</button>
            <button class="chip" data-tipo="Pesquisa" type="button" data-i18n="common.optype.research">Pesquisa</button>
            <button class="chip" data-tipo="Reposicionamento" type="button" data-i18n="common.optype.repositioning">Reposicionamento</button>
          </div>
        </div>
      </div>

      <div class="grid2">
        <div class="field">
          <label data-i18n="agendamento.origin">Origem</label>
          <div class="ap-combo">
            <input type="text" id="f-origem-busca" autocomplete="off" placeholder="ICAO ou cidade…" data-i18n-attr="placeholder:agendamento.airport.placeholder">
            <input type="hidden" id="f-origem">
            <div class="ap-combo-list" id="f-origem-lista" hidden></div>
          </div>
          <p class="hint" id="f-origem-hint"></p>
        </div>
        <div class="field">
          <label data-i18n="agendamento.destination">Destino</label>
          <div class="ap-combo">
            <input type="text" id="f-destino-busca" autocomplete="off" placeholder="ICAO ou cidade…" data-i18n-attr="placeholder:agendamento.airport.placeholder">
            <input type="hidden" id="f-destino">
            <div class="ap-combo-list" id="f-destino-lista" hidden></div>
          </div>
        </div>
      </div>

      <div class="grid3">
        <div class="field">
          <label data-i18n="agendamento.date">Data (UTC)</label>
          <input type="date" id="f-data">
        </div>
        <div class="field">
          <label data-i18n="agendamento.windowfrom">Janela — de (Z)</label>
          <input type="time" id="f-de">
        </div>
        <div class="field">
          <label data-i18n="agendamento.windowuntil">Janela — até (Z)</label>
          <input type="time" id="f-ate">
          <p class="hint" data-i18n="agendamento.rolloverhint">Se "até" for menor que "de", entende que a chegada cai no dia seguinte.</p>
        </div>
      </div>

      <div class="grid2">
        <div class="field">
          <label data-i18n="agendamento.pilot">Piloto</label>
          <input type="text" id="f-piloto">
        </div>
        <div class="field">
          <label><span data-i18n="agendamento.notes">Notas</span> <span style="text-transform:none;letter-spacing:0" data-i18n="common.optional">(opcional)</span></label>
          <input type="text" id="f-notas" placeholder="Ex.: equipe embarca no destino" data-i18n-attr="placeholder:agendamento.notes.placeholder">
        </div>
      </div>

      <div class="ag-alert" id="f-alert" hidden></div>
    </div>
    <div class="footer-actions">
      <button class="btn btn-ghost" id="f-cancel" type="button" data-i18n="common.cancel">Cancelar</button>
      <div class="right">
        <button class="btn btn-primary" id="f-submit" type="button" disabled data-i18n="agendamento.book">Agendar voo</button>
      </div>
    </div>
  </div>

  <!-- ================= AGENDA DA SEMANA (cronológica, todas as aeronaves) ================= -->
  <div class="card ag-agenda-card">
    <div class="card-h"><h3 data-i18n="agendamento.agenda.title">Agenda da semana</h3><span class="note" id="ag-agenda-count"></span></div>
    <div class="card-b" style="padding-bottom:0">
      <div class="field" style="margin-bottom:16px">
        <label data-i18n="common.search">Buscar</label>
        <input type="text" id="ag-search" placeholder="Piloto, matrícula, rota ou tipo de operação…" data-i18n-attr="placeholder:agendamento.agenda.search.placeholder">
      </div>
    </div>
    <div class="ag-table-wrap">
      <table class="ag-table" id="ag-agenda-table">
        <thead><tr><th data-i18n="agendamento.window">Janela</th><th data-i18n="common.aircraft">Aeronave</th><th data-i18n="common.route">Rota</th><th data-i18n="agendamento.type">Tipo</th><th data-i18n="agendamento.pilot">Piloto</th><th data-i18n="agendamento.sequence">Sequência</th></tr></thead>
        <tbody id="ag-agenda-body"></tbody>
      </table>
      <p class="ag-empty" id="ag-agenda-empty" style="display:none" data-i18n="agendamento.agenda.empty">Nenhum voo agendado com essa busca.</p>
    </div>
  </div>

  <!-- ================= CARDS POR AERONAVE ================= -->
  <div id="ag-cards"></div>

  <p class="hint" style="margin-top:6px" data-i18n="agendamento.mockhint">Agendar, editar e remover aqui já grava de verdade — persiste entre reloads e é visível pra qualquer piloto logado. O que ainda não existe: quando o feed real do ACARS mandar um voo que combine matrícula e janela de horário com um agendamento em aberto, ele deveria atualizar esse agendamento em vez de virar uma linha nova e solta no Logbook — essa ligação ainda não foi construída.</p>

</div>
{% endblock %}

{% block page_javascripts %}
<script>
  window.KATABATIC_AG_FLEET = {{ fleet|json_encode|raw }};
  window.KATABATIC_AG_AGENDAMENTOS = {{ agendamentos|json_encode|raw }};
  window.KATABATIC_AEROPORTOS_BUSCA_URL = {{ aeroportosBuscaUrl|json_encode|raw }};
  window.KATABATIC_NOW = {{ nowIso|json_encode|raw }};
  window.KATABATIC_PILOT_NAME = {{ pilot.name|json_encode|raw }};
</script>
