{# Rail lateral compartilhado pelas telas da area logada.
   `activeView` marca qual item do menu fica destacado
   (logbook|frota|bases|pousos|condicoes). #}
<nav class="rail">
  <div class="rail-brand">
    {% include 'partials/_brand_icon.html.twig' %}
    <b>Katabatic</b>
  </div>

  <span class="rail-group" data-i18n="rail.group">Operação</span>
  <a data-view="logbook" href="{{ path('app_portal') }}"{% if activeView == 'logbook' %} class="on"{% endif %}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 5h16v14H4zM4 9h16M9 9v10"/></svg>
    <span data-i18n="rail.logbook">Logbook</span>
  </a>
  <a data-view="frota" href="{{ path('app_portal') }}?view=frota"{% if activeView == 'frota' %} class="on"{% endif %}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M12 3l2 9 7 3v2l-9-2-9 2v-2l7-3z"/></svg>
    <span data-i18n="rail.frota">Frota</span>
  </a>
  <a data-view="bases" href="{{ path('app_portal') }}?view=bases"{% if activeView == 'bases' %} class="on"{% endif %}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="10" r="3"/><path d="M12 21s7-6.2 7-11a7 7 0 10-14 0c0 4.8 7 11 7 11z"/></svg>
    <span data-i18n="rail.bases">Bases</span>
  </a>
  <a data-view="pousos" href="{{ path('app_portal') }}?view=pousos"{% if activeView == 'pousos' %} class="on"{% endif %}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 20h18"/><path d="M5 20l6-13 6 13"/><path d="M9 13h6"/></svg>
    <span data-i18n="rail.pousos">Pousos</span>
  </a>
  <a data-view="condicoes" href="{{ path('app_portal') }}?view=condicoes"{% if activeView == 'condicoes' %} class="on"{% endif %}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 2v6"/><path d="M12 16v6"/><path d="M4.9 4.9l4.2 4.2"/><path d="M14.9 14.9l4.2 4.2"/><path d="M2 12h6"/><path d="M16 12h6"/><path d="M4.9 19.1l4.2-4.2"/><path d="M14.9 9.1l4.2-4.2"/></svg>
    <span data-i18n="rail.condicoes">Condições extremas</span>
  </a>
  <a data-view="mapaVivo" href="{{ path('app_mapa_ao_vivo') }}"{% if activeView == 'mapaVivo' %} class="on"{% endif %}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="2"/><path d="M12 5v2M12 17v2M19 12h-2M7 12H5"/><circle cx="12" cy="12" r="8" stroke-dasharray="2 3"/></svg>
    <span data-i18n="rail.mapaVivo">Mapa ao vivo</span>
  </a>
  <a data-view="agendamentos" href="{{ path('app_agendamentos') }}"{% if activeView == 'agendamentos' %} class="on"{% endif %}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/><path d="M8 13h3v3H8z"/></svg>
    <span data-i18n="rail.agendamentos">Agendamentos</span>
  </a>
  <a data-view="manuais" href="{{ path('app_manuais') }}"{% if activeView == 'manuais' %} class="on"{% endif %}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M6 3h9l4 4v13a1 1 0 01-1 1H6a1 1 0 01-1-1V4a1 1 0 011-1z"/><path d="M15 3v4h4"/><path d="M8 12h8M8 15.5h8M8 8.5h4"/></svg>
    <span data-i18n="rail.manuais">Manuais</span>
  </a>
  <a data-view="ferramentas" href="{{ path('app_ferramentas') }}"{% if activeView == 'ferramentas' %} class="on"{% endif %}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M14.7 6.3a4 4 0 015 5L9 22l-5-5L14.7 6.3z"/><path d="M9 8l3 3"/></svg>
    <span data-i18n="rail.ferramentas">Ferramentas</span>
  </a>

  {% if pilot.admin %}
  <span class="rail-group" data-i18n="rail.adminGroup">Administração</span>
  <a data-view="solicitacoes" href="{{ path('app_solicitacoes') }}"{% if activeView == 'solicitacoes' %} class="on"{% endif %}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 4h16v13H8l-4 4z"/><path d="M8 9h8M8 13h5"/></svg>
    <span data-i18n="rail.solicitacoes">Solicitações</span>
  </a>
  <a data-view="pilotos" href="{{ path('app_solicitacoes') }}?view=pilotos"{% if activeView == 'pilotos' %} class="on"{% endif %}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="9" cy="8" r="3"/><path d="M2 20c0-3.9 3.1-7 7-7s7 3.1 7 7"/><circle cx="18" cy="8" r="2.4"/><path d="M22 20c0-3-1.6-5.5-4-6.6"/></svg>
    <span data-i18n="rail.pilotos">Pilotos</span>
  </a>
  <a data-view="aeroportos" href="{{ path('app_aeroportos') }}"{% if activeView == 'aeroportos' %} class="on"{% endif %}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M2 16l20-6-2 6-6 2-4 4-2-6-6-2z"/><path d="M14 10l4-6"/></svg>
    <span data-i18n="rail.aeroportos">Aeroportos</span>
  </a>
  <a data-view="tiposAeronave" href="{{ path('app_tipos_aeronave') }}"{% if activeView == 'tiposAeronave' %} class="on"{% endif %}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 3l2 9 7 3v2l-9-2-9 2v-2l7-3z"/></svg>
    <span data-i18n="rail.tiposAeronave">Tipos de aeronave</span>
  </a>
  <a data-view="configPesquisa" href="{{ path('app_configuracao_pesquisa') }}"{% if activeView == 'configuracaoPesquisa' %} class="on"{% endif %}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8"/><circle cx="12" cy="12" r="3.5"/></svg>
    <span data-i18n="rail.configPesquisa">Pesquisa meteorológica</span>
  </a>
  {% endif %}

  <div class="rail-foot">
    {# Hora Zulu (UTC) - pedido em conversa ("acima do item de perfil"
       ficou melhor que embaixo do logo). Fica aqui em vez de em cada
       `{% block bar %}` porque a rail é a única peça de casca incluída
       igual em toda tela logada (ver app_base.html.twig); some junto
       com o resto do `.rail-foot` no layout mobile, sem precisar de
       regra própria pra isso (ver media query em app-shell.css). O
       relógio em si é só JS puro em app-shell.js (setInterval de 1s),
       sem depender de nada específico de página. #}
    <div class="rail-clock" title="Hora Zulu (UTC)">
      <span class="rail-clock-time mono" id="rail-clock-time">--:--:--</span>
      <span class="rail-clock-label">ZULU</span>
    </div>
    <a href="{{ path('app_perfil') }}" class="pilot">
      {% if pilot.photo %}
      <span class="pilot-badge pilot-badge-img"><img src="{{ pilot.photo }}" alt=""></span>
      {% else %}
      <span class="pilot-badge">{{ pilot.initials }}</span>
      {% endif %}
      <div><b>{{ pilot.name }}</b><span>CID {{ pilot.cid }}</span></div>
    </a>
    <a href="{{ path('app_logout') }}" class="rail-logout" data-i18n="rail.logout">Sair</a>
  </div>
</nav>
