{% extends 'app_base.html.twig' %}

{% block title %}Histórico — {{ aircraft.reg }} — Katabatic{% endblock %}
{% block meta_description %}Histórico de voos da aeronave {{ aircraft.reg }} no mapa, por período.{% endblock %}

{% block map_assets %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" defer></script>
{% endblock %}

{% block page_stylesheets %}
<link rel="stylesheet" href="/assets/css/pages/aeronave.css">
{% endblock %}

{% block bar %}
<div class="bar">
  <a class="back" href="{{ path('app_portal') }}?view=frota"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg><span data-i18n="rail.frota">Frota</span></a>
  <span class="sep">/</span>
  <h1 class="mono">{{ aircraft.reg }}</h1>
  <div class="right">
    <div class="lang" role="group" aria-label="Idioma" data-i18n-attr="aria-label:a11y.language">
      <button type="button" data-lang="pt" aria-pressed="true">PT</button>
      <button type="button" data-lang="en" aria-pressed="false">EN</button>
    </div>
    <button class="icon-btn" id="theme" aria-label="Tema" data-i18n-attr="aria-label:a11y.theme">
      <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
  </div>
</div>
{% endblock %}

{% block content %}
<div class="wrap">

  <div class="hero">
    <div>
      <div class="rt mono">{{ aircraft.reg }}</div>
      <p class="meta">{{ aircraft.tipo }}</p>
      <p class="meta"><span data-i18n="aeronave.base.prefix">Base</span> {{ aircraft.base }} · {{ aircraft.horas }} <span data-i18n="aeronave.base.suffix">h totais na frota</span></p>
    </div>
    <span class="tag tag-{{ aircraft.statusTag }}" style="margin-left:auto" data-i18n="{{ aircraft.status == 'Em voo' ? 'common.status.inflight' : (aircraft.status == 'Disponível' ? 'common.status.available' : (aircraft.status == 'Fora de base' ? 'common.status.awayfrombase' : '')) }}">{{ aircraft.status }}</span>
  </div>

  <div class="summary" id="ac-summary">
    <div><b class="mono" id="sum-legs">—</b><span data-i18n="aeronave.stat.legs">Pernas no período</span></div>
    <div><b class="mono" id="sum-airports">—</b><span data-i18n="aeronave.stat.airports">Aeroportos visitados</span></div>
    <div><b class="mono" id="sum-hours">—</b><span data-i18n="aeronave.stat.hours">Horas voadas</span></div>
    <div><b class="mono" id="sum-span">—</b><span data-i18n="aeronave.stat.oldest">Perna mais antiga</span></div>
  </div>

  <div class="filters">
    <select id="periodo" class="lbsel">
      <option value="0" data-i18n="common.period.all">Todo o período</option>
      <option value="7" data-i18n="common.period.7d">Últimos 7 dias</option>
      <option value="30" selected data-i18n="common.period.30d">Últimos 30 dias</option>
      <option value="90" data-i18n="common.period.90d">Últimos 90 dias</option>
      <option value="180" data-i18n="common.period.180d">Últimos 180 dias</option>
    </select>
    <div class="daterange">
      <label><span data-i18n="aeronave.date.from">De</span> <input type="date" id="ac-de"></label>
      <label><span data-i18n="aeronave.date.to">Até</span> <input type="date" id="ac-ate"></label>
      <button class="btn" id="ac-date-clear" type="button" title="Limpar datas" data-i18n="aeronave.clear" data-i18n-attr="title:aeronave.clear.title">Limpar</button>
    </div>
    <div class="chips" id="tipo-chips">
      <button class="chip on" data-tipo="Todos" type="button" data-i18n="common.all">Todos</button>
      <button class="chip" data-tipo="Carga" type="button" data-i18n="common.optype.cargo">Carga</button>
      <button class="chip" data-tipo="Pessoal" type="button" data-i18n="common.optype.personal">Pessoal</button>
      <button class="chip" data-tipo="Pesquisa" type="button" data-i18n="common.optype.research">Pesquisa</button>
      <button class="chip" data-tipo="Reposicionamento" type="button" data-i18n="common.optype.repositioning">Reposicionamento</button>
    </div>
    <label class="labeltoggle">
      <input type="checkbox" id="ac-show-acidentadas" checked>
      <span data-i18n="aeronave.filter.showcrashed">Mostrar acidentadas</span>
    </label>
    <label class="labeltoggle" title="Por padrão, cada perna mostra até 180 posições no mapa; marque para carregar o trajeto completo (todas as posições gravadas)." data-i18n-attr="title:aeronave.filter.fullres.title">
      <input type="checkbox" id="ac-fullres">
      <span data-i18n="aeronave.filter.fullres">Mostrar todas as posições</span>
      <span class="status" id="ac-fullres-status"></span>
    </label>
    <label class="labeltoggle right" title="Quando desmarcado, os labels só aparecem ao passar o mouse sobre a rota/aeroporto." data-i18n-attr="title:aeronave.map.labels.title">
      <input type="checkbox" id="ac-labels" checked>
      <span data-i18n="aeronave.map.labels">Labels sempre visíveis</span>
    </label>
  </div>

  <div class="ac-grid">
    <div class="card ac-map-card">
      <div id="ac-map"></div>
      <div class="legend-line">
        <span id="ac-map-note" data-i18n="aeronave.map.legendnote">espessura = mais recente (mais grossa) → mais antiga (mais fina)</span>
        <span style="margin-left:auto" id="ac-map-count"></span>
      </div>
    </div>

    <div class="card ac-legs-card">
      <div class="card-h"><h3 data-i18n="aeronave.legs.heading">Pernas</h3><span class="note" id="ac-legs-count"></span></div>
      <div class="table-scroll" id="ac-legs-scroll">
        <table id="ac-legs-table">
          <thead>
            <tr><th data-i18n="common.date">Data</th><th data-i18n="aeronave.th.flight">Voo</th><th data-i18n="common.route">Rota</th><th class="num" data-i18n="common.time">Tempo</th></tr>
          </thead>
          <tbody id="ac-legs-body"></tbody>
        </table>
        <div class="empty" id="ac-legs-empty" style="display:none" data-i18n="aeronave.legs.empty">Nenhuma perna nesse período.</div>
      </div>
    </div>
  </div>

</div>
{% endblock %}

