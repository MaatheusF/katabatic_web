    var d = {
      'aeronave.base.prefix': 'Base',
      'aeronave.base.suffix': 'total fleet hours',
      'aeronave.stat.legs': 'Legs in period',
      'aeronave.stat.airports': 'Airports visited',
      'aeronave.stat.hours': 'Hours flown',
      'aeronave.stat.oldest': 'Oldest leg',
      'aeronave.date.from': 'From',
      'aeronave.date.to': 'To',
      'aeronave.clear': 'Clear',
      'aeronave.clear.title': 'Clear dates',
      'aeronave.map.labels': 'Always show labels',
      'aeronave.map.labels.title': 'When unchecked, labels only appear when you hover over the route/airport.',
      'aeronave.filter.showcrashed': 'Show crashed legs',
      'aeronave.leg.crashed': 'Crashed',
      'aeronave.map.legendnote': 'thickness = most recent (thicker) → oldest (thinner)',
      'aeronave.legs.heading': 'Legs',
