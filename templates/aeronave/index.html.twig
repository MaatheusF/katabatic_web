{% extends 'app_base.html.twig' %}

{% block title %}Histórico — {{ aircraft.reg }} — Katabatic{% endblock %}
{% block meta_description %}Histórico de voos da aeronave {{ aircraft.reg }} no mapa, por período.{% endblock %}

{% block map_assets %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" defer></script>
{% endblock %}

{% block page_stylesheets %}
<link rel="stylesheet" href="/assets/css/pages/aeronave.css">
{% endblock %}

{% block bar %}
<div class="bar">
  <a class="back" href="{{ path('app_portal') }}?view=frota"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg><span data-i18n="rail.frota">Frota</span></a>
  <span class="sep">/</span>
  <h1 class="mono">{{ aircraft.reg }}</h1>
  <div class="right">
    <div class="lang" role="group" aria-label="Idioma">
      <button type="button" data-lang="pt" aria-pressed="true">PT</button>
      <button type="button" data-lang="en" aria-pressed="false">EN</button>
    </div>
    <button class="icon-btn" id="theme" aria-label="Tema">
      <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
  </div>
</div>
{% endblock %}

{% block content %}
<div class="wrap">

  <div class="hero">
    <div>
      <div class="rt mono">{{ aircraft.reg }}</div>
      <p class="meta">{{ aircraft.tipo }}</p>
      <p class="meta">Base {{ aircraft.base }} · {{ aircraft.horas }} h totais na frota</p>
    </div>
    <span class="tag tag-{{ aircraft.statusTag }}" style="margin-left:auto">{{ aircraft.status }}</span>
  </div>

  <div class="summary" id="ac-summary">
    <div><b class="mono" id="sum-legs">—</b><span>Pernas no período</span></div>
    <div><b class="mono" id="sum-airports">—</b><span>Aeroportos visitados</span></div>
    <div><b class="mono" id="sum-hours">—</b><span>Horas voadas</span></div>
    <div><b class="mono" id="sum-span">—</b><span>Perna mais antiga</span></div>
  </div>

  <div class="filters">
    <select id="periodo" class="lbsel">
      <option value="0">Todo o período</option>
      <option value="7">Últimos 7 dias</option>
      <option value="30" selected>Últimos 30 dias</option>
      <option value="90">Últimos 90 dias</option>
      <option value="180">Últimos 180 dias</option>
    </select>
    <div class="daterange">
      <label>De <input type="date" id="ac-de"></label>
      <label>Até <input type="date" id="ac-ate"></label>
      <button class="btn" id="ac-date-clear" type="button" title="Limpar datas">Limpar</button>
    </div>
    <div class="chips" id="tipo-chips">
      <button class="chip on" data-tipo="Todos" type="button">Todos</button>
      <button class="chip" data-tipo="Carga" type="button">Carga</button>
      <button class="chip" data-tipo="Pessoal" type="button">Pessoal</button>
      <button class="chip" data-tipo="Pesquisa" type="button">Pesquisa</button>
      <button class="chip" data-tipo="Reposicionamento" type="button">Reposicionamento</button>
    </div>
    <label class="labeltoggle right">
      <input type="checkbox" id="ac-labels" checked>
      <span>Labels no mapa</span>
    </label>
  </div>

  <div class="ac-grid">
    <div class="card ac-map-card">
      <div id="ac-map"></div>
      <div class="legend-line">
        <span id="ac-map-note">cor e espessura = mais recente (forte) → mais antiga (fraca)</span>
        <span style="margin-left:auto" id="ac-map-count"></span>
      </div>
    </div>

    <div class="card ac-legs-card">
      <div class="card-h"><h3>Pernas</h3><span class="note" id="ac-legs-count"></span></div>
      <div class="table-scroll" id="ac-legs-scroll">
        <table id="ac-legs-table">
          <thead>
            <tr><th>Data</th><th>Voo</th><th>Rota</th><th class="num">Tempo</th></tr>
          </thead>
          <tbody id="ac-legs-body"></tbody>
        </table>
        <div class="empty" id="ac-legs-empty" style="display:none">Nenhuma perna nesse período.</div>
      </div>
    </div>
  </div>

</div>
{% endblock %}

{% block page_javascripts %}
<script>
  window.KATABATIC_AC_LEGS = {{ legs|json_encode|raw }};
  window.KATABATIC_AIRPORTS_URL = {{ airportsUrl|json_encode|raw }};
  window.KATABATIC_NOW = {{ nowIso|json_encode|raw }};
</script>
<script src="/assets/js/pages/aeronave.js" defer></script>
{% endblock %}
