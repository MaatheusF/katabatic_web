      'configpesquisa.unit.min': 'min',
      'configpesquisa.unit.tiles': 'tiles',
      'configpesquisa.unit.kt': 'kt',
      'configpesquisa.unit.mmh': 'mm/h',
      'configpesquisa.save': 'Save configuration'
    };
    for (var k in d) { window.KATABATIC_I18N_EN[k] = d[k]; }
  })();
</script>
{% endblock %}
