{% extends 'app_base.html.twig' %}

{% block title %}Configurações da pesquisa meteorológica — Katabatic{% endblock %}
{% block meta_description %}Cadência de amostragem/captura e limiares de severidade da camada de pesquisa meteorológica.{% endblock %}

{% block page_stylesheets %}
<link rel="stylesheet" href="/assets/css/pages/tipo-aeronave.css">
{% endblock %}

{% block bar %}
<div class="bar">
  <h1 data-i18n="configpesquisa.title">Pesquisa meteorológica</h1>
  <div class="right">
    <div class="lang" role="group" aria-label="Idioma" data-i18n-attr="aria-label:a11y.language">
      <button type="button" data-lang="pt" aria-pressed="true">PT</button>
      <button type="button" data-lang="en" aria-pressed="false">EN</button>
    </div>
    <button class="icon-btn" id="theme" aria-label="Tema" data-i18n-attr="aria-label:a11y.theme">
      <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
  </div>
</div>
{% endblock %}

{% block content %}
<div class="wrap">

  <p class="ta-intro" data-i18n="configpesquisa.intro">Estes parâmetros controlam a captura ao vivo de condições ambiente (vento/temperatura/precipitação) e de mapa/vento por altitude durante voos de pesquisa (<b>tipo de operação "Pesquisa"</b>), além dos limiares que classificam a severidade de cada amostra no relatório automático.</p>

  {% if errors is defined and errors is not empty %}
  <div class="ta-error" id="cp-error">
    <ul>
      {% for error in errors %}
      <li>{{ error }}</li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}

  <form method="post" action="{{ path('app_configuracao_pesquisa_atualizar') }}">

    <div class="card">
      <div class="card-h"><h3 data-i18n="configpesquisa.cadencia.title">Cadência de captura</h3></div>
      <div class="card-b">
        <div class="grid2">
          <div class="field">
            <label for="f-amostra" data-i18n="configpesquisa.amostra">Amostra ambiente</label>
            <div class="unit-row"><input type="number" class="mono-input" id="f-amostra" name="amostraCadenciaMin" step="1" min="1" max="60" value="{{ config.amostraCadenciaMin }}" required><span class="unit" data-i18n="configpesquisa.unit.min">min</span></div>
            <p class="hint" data-i18n="configpesquisa.amostra.hint">De quanto em quanto tempo o vento/temperatura/pressão/precipitação ao redor da aeronave são consultados e registrados.</p>
          </div>
          <div class="field">
            <label for="f-captura" data-i18n="configpesquisa.captura">Mapa e vento por altitude</label>
            <div class="unit-row"><input type="number" class="mono-input" id="f-captura" name="capturaCadenciaMin" step="1" min="5" max="180" value="{{ config.capturaCadenciaMin }}" required><span class="unit" data-i18n="configpesquisa.unit.min">min</span></div>
            <p class="hint" data-i18n="configpesquisa.captura.hint">De quanto em quanto tempo o mapa (imagem + tiles) e a grade de vento por altitude são baixados e armazenados permanentemente para replay histórico.</p>
          </div>
        </div>
        <div class="grid2">
          <div class="field" style="margin-bottom:0">
            <label for="f-grid-raio" data-i18n="configpesquisa.gridRaio">Raio da grade de mapa</label>
            <div class="unit-row"><input type="number" class="mono-input" id="f-grid-raio" name="mapaGridRaio" step="1" min="1" max="15" value="{{ config.mapaGridRaio }}" required><span class="unit" data-i18n="configpesquisa.unit.tiles">tiles</span></div>
            <p class="hint" data-i18n="configpesquisa.gridRaio.hint">Quantos tiles ao redor da aeronave são baixados em cada direção — 1 = grade 3×3 (só o entorno imediato), 10 = grade 21×21 (região bem mais ampla). Cada unidade a mais multiplica o número de tiles baixados por captura e o tempo/memória gastos pra compor a imagem — aumente aos poucos e observe se a captura ainda completa sem estourar tempo/memória do PHP.</p>
          </div>
          <div class="field" style="margin-bottom:0"></div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-h"><h3 data-i18n="configpesquisa.niveis.title">Níveis de pressão do vento</h3></div>
      <div class="card-b">
        <div class="field" style="margin-bottom:0">
          <label for="f-niveis" data-i18n="configpesquisa.niveis">Níveis (hPa), do solo à alta troposfera</label>
          <input type="text" class="mono-input" id="f-niveis" name="niveisPressaoHpa" value="{{ config.niveisPressaoHpa|join(', ') }}" placeholder="1000, 925, 850, 700, 500, 300" required>
          <p class="hint" data-i18n="configpesquisa.niveis.hint">Separados por vírgula. Cada nível a mais multiplica o tamanho da grade de vento armazenada a cada captura — até 12 níveis.</p>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-h"><h3 data-i18n="configpesquisa.severidade.title">Limiares de severidade</h3><span class="note" data-i18n="configpesquisa.severidade.note">alimentam o indicador e o relatório automático</span></div>
      <div class="card-b">
        <div class="grid2">
          <div class="field">
            <label for="f-vento-mod" data-i18n="configpesquisa.ventoModerado">Vento sustentado — moderado a partir de</label>
            <div class="unit-row"><input type="number" class="mono-input" id="f-vento-mod" name="ventoModeradoKt" step="1" min="0" max="200" value="{{ config.ventoModeradoKt }}" required><span class="unit" data-i18n="configpesquisa.unit.kt">kt</span></div>
          </div>
          <div class="field">
            <label for="f-vento-sev" data-i18n="configpesquisa.ventoSevero">Vento sustentado — severo a partir de</label>
            <div class="unit-row"><input type="number" class="mono-input" id="f-vento-sev" name="ventoSeveroKt" step="1" min="0" max="250" value="{{ config.ventoSeveroKt }}" required><span class="unit" data-i18n="configpesquisa.unit.kt">kt</span></div>
          </div>
        </div>
        <div class="grid2">
          <div class="field">
            <label for="f-rajada-sev" data-i18n="configpesquisa.rajadaSevera">Rajada — severo a partir de</label>
            <div class="unit-row"><input type="number" class="mono-input" id="f-rajada-sev" name="rajadaSeveraKt" step="1" min="0" max="250" value="{{ config.rajadaSeveraKt }}" required><span class="unit" data-i18n="configpesquisa.unit.kt">kt</span></div>
          </div>
          <div class="field" style="margin-bottom:0"></div>
        </div>
        <div class="grid2">
          <div class="field">
            <label for="f-precip-mod" data-i18n="configpesquisa.precipModerada">Precipitação — moderada a partir de</label>
            <div class="unit-row"><input type="number" class="mono-input" id="f-precip-mod" name="precipModeradaMmH" step="0.1" min="0" max="500" value="{{ config.precipModeradaMmH }}" required><span class="unit" data-i18n="configpesquisa.unit.mmh">mm/h</span></div>
          </div>
          <div class="field">
            <label for="f-precip-sev" data-i18n="configpesquisa.precipSevera">Precipitação — severa a partir de</label>
            <div class="unit-row"><input type="number" class="mono-input" id="f-precip-sev" name="precipSeveraMmH" step="0.1" min="0" max="500" value="{{ config.precipSeveraMmH }}" required><span class="unit" data-i18n="configpesquisa.unit.mmh">mm/h</span></div>
          </div>
        </div>
      </div>
    </div>

    <div class="footer-actions">
      <a class="btn btn-ghost" href="{{ path('app_portal') }}" data-i18n="common.cancel">Cancelar</a>
      <div class="right">
        <button type="submit" class="btn btn-primary" data-i18n="configpesquisa.save">Salvar configuração</button>
      </div>
    </div>

  </form>

</div>
{% endblock %}

{% block page_javascripts %}
<script>
  (function () {
    var d = {
      'configpesquisa.title': 'Weather research',
      'configpesquisa.intro': 'These parameters control the live capture of ambient conditions (wind/temperature/precipitation) and of the map/wind-by-altitude during research flights (operation type "Research"), plus the thresholds that classify each sample\'s severity in the automated report.',
      'configpesquisa.cadencia.title': 'Capture cadence',
      'configpesquisa.amostra': 'Ambient sample',
      'configpesquisa.amostra.hint': 'How often the wind/temperature/pressure/precipitation around the aircraft is queried and logged.',
