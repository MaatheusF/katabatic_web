{% extends 'app_base.html.twig' %}

{% block title %}Ferramentas do piloto — Katabatic{% endblock %}
{% block meta_description %}Calculadoras de vento, unidades/QNH, peso e balanceamento, distância de decolagem/pouso, fuso horário das Bases, planeio, ponto de descida e gerador de callsign da Katabatic.{% endblock %}

{% block page_stylesheets %}
<link rel="stylesheet" href="/assets/css/pages/ferramentas.css">
{% endblock %}

{% block bar %}
<div class="bar">
  <h1 data-i18n="ferramentas.title">Ferramentas do piloto</h1>
  <div class="right">
    <div class="lang" role="group" aria-label="Idioma" data-i18n-attr="aria-label:a11y.language">
      <button type="button" data-lang="pt" aria-pressed="true">PT</button>
      <button type="button" data-lang="en" aria-pressed="false">EN</button>
    </div>
    <button class="icon-btn" id="theme" aria-label="Tema" data-i18n-attr="aria-label:a11y.theme">
      <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
  </div>
</div>
{% endblock %}

{% block content %}
<div class="wrap">

  <div class="tools-grid">

    <!-- Vento cruzado / cauda -->
    <div class="card">
      <div class="card-h"><h3 data-i18n="tools.wind.title">Vento cruzado / cauda</h3></div>
      <div class="card-b">
        <div class="grid3">
          <div class="field">
            <label data-i18n="tools.wind.rwy">Pista</label>
            <input type="number" class="mono-input" id="w-rwy" min="1" max="36" placeholder="27">
            <p class="hint" data-i18n="tools.wind.rwy.hint">Número da cabeceira (1–36) — ex. 27 = 270°.</p>
          </div>
          <div class="field">
            <label data-i18n="tools.wind.dir">Vento — direção</label>
            <div class="unit-row"><input type="number" class="mono-input" id="w-dir" min="0" max="360" placeholder="250"><span class="unit">°</span></div>
          </div>
          <div class="field">
            <label data-i18n="tools.wind.speed">Vento — intensidade</label>
            <div class="unit-row"><input type="number" class="mono-input" id="w-speed" min="0" placeholder="14"><span class="unit">kt</span></div>
          </div>
        </div>
        <div class="result" id="w-result"></div>
      </div>
    </div>

    <!-- Conversor de unidades + ETA -->
    <div class="card">
      <div class="card-h"><h3 data-i18n="tools.conv.title">Conversor de unidades + ETA</h3></div>
      <div class="card-b">
        <div class="field">
          <label data-i18n="tools.conv.category">Categoria</label>
          <div class="chips" id="conv-cat-chips">
            <button class="chip on" data-cat="dist" type="button" data-i18n="tools.conv.cat.dist">Distância</button>
            <button class="chip" data-cat="speed" type="button" data-i18n="tools.conv.cat.speed">Velocidade</button>
            <button class="chip" data-cat="weight" type="button" data-i18n="tools.conv.cat.weight">Peso</button>
            <button class="chip" data-cat="fuel" type="button" data-i18n="tools.conv.cat.fuel">Combustível</button>
            <button class="chip" data-cat="alt" type="button" data-i18n="tools.conv.cat.alt">Altitude</button>
            <button class="chip" data-cat="pressure" type="button" data-i18n="tools.conv.cat.pressure">Pressão (QNH)</button>
          </div>
        </div>
        <div class="grid3">
          <div class="field">
            <label data-i18n="tools.conv.value">Valor</label>
            <input type="number" class="mono-input" id="conv-value" placeholder="120">
          </div>
          <div class="field">
            <label data-i18n="tools.conv.from">De</label>
            <select id="conv-from"></select>
          </div>
          <div class="field">
            <label data-i18n="tools.conv.to">Para</label>
            <select id="conv-to"></select>
          </div>
        </div>
        <div class="result" id="conv-result"></div>

        <div class="eta-box">
          <p class="eta-heading" data-i18n="tools.eta.title">ETA</p>
          <div class="grid3">
            <div class="field">
              <label data-i18n="tools.eta.dist">Distância</label>
              <div class="unit-row"><input type="number" class="mono-input" id="eta-dist" min="0" placeholder="185"><span class="unit">nm</span></div>
            </div>
            <div class="field">
              <label data-i18n="tools.eta.gs">Velocidade no solo</label>
              <div class="unit-row"><input type="number" class="mono-input" id="eta-gs" min="1" placeholder="140"><span class="unit">kt</span></div>
            </div>
            <div class="field">
              <label><span data-i18n="tools.eta.dep">Partida</span> <span class="opt" data-i18n="common.optional">(opcional)</span></label>
              <input type="time" class="mono-input" id="eta-dep">
            </div>
          </div>
          <div class="result" id="eta-result"></div>
        </div>
      </div>
    </div>

    <!-- Peso e balanceamento -->
    <div class="card">
      <div class="card-h"><h3 data-i18n="tools.wb.title">Peso e balanceamento</h3></div>
      <div class="card-b">
        <p class="tool-note" data-i18n="tools.wb.scope">Verifica só o <b>peso total vs. MTOW</b> — não calcula CG/envelope. Não substitui o manifesto de peso e balanceamento do voo.</p>
        <div class="field">
          <label data-i18n="tools.wb.aircraft">Aeronave</label>
          <select id="wb-aircraft">
            <option value="" data-i18n="tools.wb.aircraft.select">Selecione…</option>
          </select>
        </div>
        <div class="wb-ref" id="wb-ref" style="display:none"></div>
        <div class="wb-missing" id="wb-missing" style="display:none"></div>
        <div class="grid3" id="wb-fields" style="display:none">
          <div class="field">
            <label data-i18n="tools.wb.crew">Tripulação + piloto</label>
            <div class="unit-row"><input type="number" class="mono-input" id="wb-crew" min="0" placeholder="180"><span class="unit">lb</span></div>
          </div>
          <div class="field">
            <label data-i18n="tools.wb.payload">Passageiros + carga</label>
            <div class="unit-row"><input type="number" class="mono-input" id="wb-payload" min="0" placeholder="600"><span class="unit">lb</span></div>
          </div>
          <div class="field">
            <label data-i18n="tools.wb.fuel">Combustível</label>
            <div class="unit-row"><input type="number" class="mono-input" id="wb-fuel" min="0" placeholder="150"><span class="unit">gal</span></div>
          </div>
        </div>
        <div class="field" id="wb-density-field" style="display:none;margin-bottom:0">
          <label data-i18n="tools.wb.density">Densidade do combustível</label>
          <div class="chips" id="wb-density-chips">
            <button class="chip" data-density="6.0" type="button" data-i18n="tools.wb.density.avgas">Avgas (6,0 lb/gal)</button>
            <button class="chip on" data-density="6.7" type="button" data-i18n="tools.wb.density.jeta">Jet A (6,7 lb/gal)</button>
          </div>
        </div>
        <div class="result" id="wb-result"></div>
      </div>
    </div>

    <!-- Distância de decolagem/pouso ajustada -->
    <div class="card">
      <div class="card-h"><h3 data-i18n="tools.dist.title">Distância de decolagem/pouso ajustada</h3></div>
      <div class="card-b">
        <p class="tool-note" data-i18n="tools.dist.scope"><b>Estimativa aproximada</b> por regra de bolso (densidade + vento) sobre a distância de referência do tipo — não substitui o gráfico de performance do POH.</p>
        <div class="field">
          <label data-i18n="tools.dist.type">Tipo de aeronave</label>
          <select id="dist-type">
            <option value="" data-i18n="tools.dist.type.select">Selecione…</option>
          </select>
        </div>
        <div class="wb-missing" id="dist-missing" style="display:none"></div>
        <div id="dist-fields" style="display:none">
          <div class="grid3">
            <div class="field">
              <label data-i18n="tools.dist.elev">Elevação da pista</label>
              <div class="unit-row"><input type="number" class="mono-input" id="dist-elev" placeholder="440"><span class="unit">ft</span></div>
            </div>
            <div class="field">
              <label data-i18n="tools.dist.oat">Temperatura (OAT)</label>
              <div class="unit-row"><input type="number" class="mono-input" id="dist-oat" placeholder="15"><span class="unit">°C</span></div>
            </div>
            <div class="field">
              <label data-i18n="tools.dist.wind">Vento de proa/cauda</label>
              <div class="unit-row"><input type="number" class="mono-input" id="dist-wind" placeholder="8"><span class="unit">kt</span></div>
            </div>
          </div>
          <p class="hint" data-i18n="tools.dist.wind.hint">Positivo = vento de proa, negativo = cauda — use o resultado da calculadora de vento cruzado acima.</p>
        </div>
        <div class="result" id="dist-result"></div>
      </div>
    </div>

    <!-- Zulu (UTC) x hora local das Bases -->
    <div class="card">
      <div class="card-h"><h3 data-i18n="tools.zulu.title">Zulu (UTC) × hora local das Bases</h3></div>
      <div class="card-b">
        <p class="tool-note" data-i18n="tools.zulu.scope">Planos de voo VATSIM usam sempre Zulu (UTC) — informe uma hora de referência e veja a correspondente em cada Base, sem precisar decorar fuso.</p>
        <div class="zulu-row">
          <div class="field">
            <label data-i18n="tools.zulu.time">Hora</label>
            <input type="time" class="mono-input" id="zulu-time">
          </div>
          <div class="field">
            <label data-i18n="tools.zulu.ref">Fuso de referência</label>
            <select id="zulu-ref">
              <option value="UTC" data-i18n="tools.zulu.ref.utc">Zulu (UTC)</option>
              <option value="America/Anchorage">PAFA — Fairbanks, Alasca</option>
              <option value="America/Punta_Arenas">SCCI — Punta Arenas, Chile</option>
              <option value="America/La_Paz">SLLP — La Paz, Bolívia</option>
              <option value="Asia/Kathmandu">VNKT — Catmandu, Nepal</option>
              <option value="Asia/Jayapura">WAJW — Wamena, Nova Guiné</option>
              <option value="Asia/Thimphu">VQPR — Paro, Butão</option>
            </select>
          </div>
          <button class="btn" type="button" id="zulu-now" data-i18n="tools.zulu.now">Agora</button>
        </div>
        <p class="hint" data-i18n="tools.zulu.hint">Fuso calculado pro instante atual (cobre horário de verão onde existe) — não leva em conta virada de data em trânsito entre fusos muito distantes.</p>
        <div class="result" id="zulu-result"></div>
      </div>
    </div>

    <!-- Alcance de planeio (engine-out) -->
    <div class="card">
      <div class="card-h"><h3 data-i18n="tools.glide.title">Alcance de planeio (engine-out)</h3></div>
      <div class="card-b">
        <p class="tool-note" data-i18n="tools.glide.scope"><b>Estimativa aproximada</b> — regra de bolso pra planejamento de pouso de emergência, não substitui os números de planeio do POH da aeronave.</p>
        <div class="grid3">
          <div class="field">
            <label data-i18n="tools.glide.alt">Altitude disponível</label>
            <div class="unit-row"><input type="number" class="mono-input" id="glide-alt" min="0" placeholder="3000"><span class="unit">ft</span></div>
          </div>
          <div class="field">
            <label data-i18n="tools.glide.ratio">Razão de planeio (L/D)</label>
            <input type="number" class="mono-input" id="glide-ratio" min="1" step="0.1" placeholder="9">
            <p class="hint" data-i18n="tools.glide.ratio.hint">Ex.: ~9:1 num monomotor leve típico — confira o POH da aeronave.</p>
          </div>
          <div class="field">
            <label><span data-i18n="tools.glide.wind">Vento de proa/cauda</span> <span class="opt" data-i18n="common.optional">(opcional)</span></label>
            <div class="unit-row"><input type="number" class="mono-input" id="glide-wind" placeholder="0"><span class="unit">kt</span></div>
            <p class="hint" data-i18n="tools.glide.wind.hint">Positivo = proa (reduz alcance), negativo = cauda (aumenta) — mesma referência da calculadora de vento cruzado.</p>
          </div>
        </div>
        <div class="result" id="glide-result"></div>
      </div>
    </div>

    <!-- Ponto ideal de descida (TOD) -->
    <div class="card">
      <div class="card-h"><h3 data-i18n="tools.tod.title">Ponto ideal de descida (TOD)</h3></div>
      <div class="card-b">
        <p class="tool-note" data-i18n="tools.tod.scope"><b>Estimativa aproximada</b> — regra de bolso trigonométrica, não considera desaceleração nem restrições de descida do ATC.</p>
        <div class="field">
          <label data-i18n="tools.tod.method">Método</label>
          <div class="chips" id="tod-method-chips">
            <button class="chip on" data-method="rate" type="button" data-i18n="tools.tod.method.rate">Taxa de descida (fpm)</button>
            <button class="chip" data-method="angle" type="button" data-i18n="tools.tod.method.angle">Ângulo (°)</button>
          </div>
        </div>
        <div class="grid3">
          <div class="field">
            <label data-i18n="tools.tod.alt">Altitude a perder</label>
            <div class="unit-row"><input type="number" class="mono-input" id="tod-alt" min="0" placeholder="8000"><span class="unit">ft</span></div>
          </div>
          <div class="field">
            <label data-i18n="tools.tod.gs">Velocidade no solo</label>
            <div class="unit-row"><input type="number" class="mono-input" id="tod-gs" min="1" placeholder="150"><span class="unit">kt</span></div>
          </div>
          <div class="field" id="tod-rate-field">
            <label data-i18n="tools.tod.rate">Taxa de descida</label>
            <div class="unit-row"><input type="number" class="mono-input" id="tod-rate" min="1" placeholder="500"><span class="unit">fpm</span></div>
          </div>
          <div class="field" id="tod-angle-field" style="display:none">
            <label data-i18n="tools.tod.angle">Ângulo de descida</label>
            <div class="unit-row"><input type="number" class="mono-input" id="tod-angle" min="0.1" step="0.1" placeholder="3"><span class="unit">°</span></div>
          </div>
        </div>
        <div class="result" id="tod-result"></div>
      </div>
    </div>

    <!-- Gerador de callsign / número de voo -->
    <div class="card">
      <div class="card-h"><h3 data-i18n="tools.callsign.title">Gerador de callsign / número de voo</h3></div>
      <div class="card-b">
        <p class="tool-note" data-i18n="tools.callsign.scope">O número vem da <b>rota</b> (origem → destino) + do <b>tipo de operação</b> — a mesma rota sempre gera o mesmo número, e o sentido contrário sai no número vizinho (par/ímpar), igual companhia aérea de verdade faz. A aeronave selecionada é só referência: não entra no cálculo.</p>
        <div class="field">
          <label data-i18n="tools.callsign.type">Tipo de operação</label>
          <div class="chips" id="cs-tipo-chips">
            <button class="chip on" data-tipo="Carga" type="button" data-i18n="common.optype.cargo">Carga</button>
            <button class="chip" data-tipo="Pessoal" type="button" data-i18n="common.optype.personal">Pessoal</button>
            <button class="chip" data-tipo="Pesquisa" type="button" data-i18n="common.optype.research">Pesquisa</button>
            <button class="chip" data-tipo="Medvec" type="button" data-i18n="common.optype.medevac">Medvec</button>
            <button class="chip" data-tipo="Reposicionamento" type="button" data-i18n="common.optype.repositioning">Reposicionamento</button>
          </div>
        </div>
        <div class="grid3">
          <div class="field">
            <label data-i18n="tools.callsign.origem">Origem (ICAO)</label>
            <input type="text" class="mono-input" id="cs-origem" maxlength="4" placeholder="PAFA">
          </div>
          <div class="field">
            <label data-i18n="tools.callsign.destino">Destino (ICAO)</label>
            <input type="text" class="mono-input" id="cs-destino" maxlength="4" placeholder="PABT">
          </div>
          <div class="field">
            <label><span data-i18n="tools.callsign.aircraft">Aeronave</span> <span class="opt" data-i18n="common.optional">(opcional)</span></label>
            <select id="cs-aircraft">
              <option value="" data-i18n="tools.callsign.aircraft.select">Selecione…</option>
            </select>
          </div>
        </div>
        <button class="btn" type="button" id="cs-swap" data-i18n="tools.callsign.swap">Inverter rota</button>
        <div class="result" id="cs-result"></div>
      </div>
    </div>

  </div>

</div>
{% endblock %}

